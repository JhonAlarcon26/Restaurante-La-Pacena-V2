@model UnidadDeMedidum
@{ ViewData["Title"] = "Editar Unidad"; }
<div class="max-w-3xl mx-auto">
    <nav class="flex mb-6"><ol class="inline-flex items-center space-x-1"><li><a asp-action="Listar" class="text-sm font-medium text-slate-700 hover:text-primary">Unidades</a></li><li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li><li><span class="text-sm text-slate-500">Editar</span></li></ol></nav>
    <div class="bg-white rounded-xl shadow-lg border overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-4"><h2 class="text-2xl font-bold text-white">Editar Unidad</h2></div>
        <form asp-action="Editar" class="p-6">
            <input type="hidden" asp-for="IdUnidad" />
            <div class="space-y-6">
                <div><label asp-for="Nombre" class="block text-sm font-semibold text-slate-700 mb-2">Nombre *</label><input asp-for="Nombre" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-amber-500" /></div>
                <div><label asp-for="Abreviatura" class="block text-sm font-semibold text-slate-700 mb-2">Abreviatura *</label><input asp-for="Abreviatura" class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-amber-500" /></div>
            </div>
            <div class="flex justify-end space-x-3 mt-8 pt-6 border-t"><a asp-action="Listar" class="px-6 py-3 bg-slate-100 rounded-lg">Cancelar</a><button type="submit" class="px-6 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg shadow-lg">Guardar</button></div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/unidaddemedida-validation.js"></script>
}
