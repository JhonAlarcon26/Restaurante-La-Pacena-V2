@model Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="max-w-3xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Proveedores
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Editar</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Editar Proveedor</h2>
            <p class="text-amber-100 mt-1">Modifica los datos del proveedor</p>
        </div>

        <form asp-action="Editar" class="p-6">
            <input type="hidden" asp-for="IdProveedor" />
            <div asp-validation-summary="ModelOnly" class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>
            
            <div class="space-y-6">
                <div>
                    <label asp-for="NombreEmpresa" class="block text-sm font-semibold text-slate-700 mb-2">
                        Empresa <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="NombreEmpresa" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                    <span asp-validation-for="NombreEmpresa" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="NitCarnet" class="block text-sm font-semibold text-slate-700 mb-2">
                        NIT/Carnet
                    </label>
                    <input asp-for="NitCarnet" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent" placeholder="NIT o Carnet del proveedor" />
                </div>

                <div>
                    <label asp-for="ContactoNombre" class="block text-sm font-semibold text-slate-700 mb-2">
                        Nombre de Contacto
                    </label>
                    <input asp-for="ContactoNombre" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Telefono" class="block text-sm font-semibold text-slate-700 mb-2">
                            Teléfono
                        </label>
                        <input asp-for="Telefono" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-2">
                            Email
                        </label>
                        <input asp-for="Email" type="email" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                    </div>
                </div>

                <div class="flex items-center">
                    <input name="Estado" type="checkbox" value="true" @(Model.Estado == true ? "checked" : "") class="w-4 h-4 text-amber-500 border-slate-300 rounded focus:ring-amber-500" />
                    <input name="Estado" type="hidden" value="false" />
                    <label for="Estado" class="ml-2 block text-sm text-slate-700">
                        Activo
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-slate-200">
                <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Actualizar
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var input = document.querySelector("#Telefono");
        if (input) {
            window.intlTelInput(input, {
                utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/js/utils.js",
                dropdownContainer: document.body,
                separateDialCode: true,
                countrySearch: true,
                onlyCountries: [
                    // América del Sur
                    "ar", "bo", "br", "cl", "co", "ec", "py", "pe", "uy", "ve", "gy", "sr",
                    // América del Norte y Central
                    "us", "ca", "mx", "gt", "bz", "sv", "hn", "ni", "cr", "pa",
                    // Caribe
                    "cu", "do", "ht", "jm", "tt", "bs", "bb", "gd", "ag", "dm", "kn", "lc", "vc",
                    // Europa Importantes
                    "es", "gb", "fr", "de", "it", "pt", "ru", "ua", "nl", "be", "ch", "se", "no", "dk", "fi", "ie"
                ],
                preferredCountries: ["bo", "ar", "br", "pe", "cl", "co", "mx"],
                initialCountry: "bo"
            });
            input.addEventListener('input', function() { this.value = this.value.replace(/[^0-9]/g, ''); });
        }
    </script>
}
