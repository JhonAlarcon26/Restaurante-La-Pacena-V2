@model Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="max-w-3xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Productos
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Nuevo</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary to-secondary px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Crear Producto</h2>
            <p class="text-blue-100 mt-1">Registra un nuevo producto para reventa</p>
        </div>

        <form asp-action="Crear" class="p-6">
            <div asp-validation-summary="ModelOnly" class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>
            
            <div class="space-y-6">
                <div>
                    <label asp-for="Nombre" class="block text-sm font-semibold text-slate-700 mb-2">
                        Nombre del Producto <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Nombre" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Ej: Coca Cola 500ml" />
                    <span asp-validation-for="Nombre" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="CodigoBarras" class="block text-sm font-semibold text-slate-700 mb-2">
                        Código de Barras
                    </label>
                    <input asp-for="CodigoBarras" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Código de barras (Opcional)" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="IdTipoProducto" class="block text-sm font-semibold text-slate-700 mb-2">
                            Tipo de Producto <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="IdTipoProducto" asp-items="ViewBag.TiposProducto" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="">Seleccione tipo</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="IdUnidad" class="block text-sm font-semibold text-slate-700 mb-2">
                            Unidad de Medida <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="IdUnidad" asp-items="ViewBag.Unidades" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="">Seleccione unidad</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="StockActual" class="block text-sm font-semibold text-slate-700 mb-2">
                            Stock Actual
                        </label>
                        <input asp-for="StockActual" type="number" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0" />
                    </div>
                    <div>
                        <label asp-for="StockMinimo" class="block text-sm font-semibold text-slate-700 mb-2">
                            Stock Mínimo
                        </label>
                        <input asp-for="StockMinimo" type="number" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="5" />
                    </div>
                    <div>
                        <label asp-for="PrecioCompraActual" class="block text-sm font-semibold text-slate-700 mb-2">
                            Precio de Compra (Bs.)
                        </label>
                        <input asp-for="PrecioCompraActual" value="@FormatDecimal(Model?.PrecioCompraActual)" type="number" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0" />
                    </div>
                    <div>
                        <label asp-for="PrecioVenta" class="block text-sm font-semibold text-slate-700 mb-2">
                            Precio de Venta (Bs.) <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="PrecioVenta" value="@FormatDecimal(Model?.PrecioVenta)" type="number" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0" />
                        <span asp-validation-for="PrecioVenta" class="text-red-500 text-sm"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-slate-200">
                <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Guardar
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@functions {
    string FormatDecimal(decimal? value)
    {
        if (value == null) return "";
        decimal val = value.Value;
        // Si el valor es entero (sin decimales), mostrar sin decimales
        if (val == Math.Floor(val))
            return val.ToString("F0");
        // Si tiene decimales, mostrar máximo 2 decimales
        return val.ToString("0.##");
    }
}
