@model Compra

@{
    ViewData["Title"] = "Nueva Compra";
}

<div class="max-w-6xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Compras
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Nueva Compra Unificada</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary to-secondary px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Registrar Compra</h2>
            <p class="text-purple-100 mt-1">Ingresa insumos y productos en una sola transacción</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mx-6 mt-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded">
                <span class="font-semibold">@TempData["Error"]</span>
            </div>
        }

        <div id="customAlert" class="hidden mx-6 mt-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded shadow-md transition-all duration-300">
             <div class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <h3 class="font-bold">Error de Validación</h3>
                    <p id="customAlertMessage">Mensaje de error</p>
                </div>
                <button onclick="document.getElementById('customAlert').classList.add('hidden')" class="ml-auto text-red-500 hover:text-red-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <form asp-action="Crear" method="post" id="formCompra" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="detallesJson" id="detallesJson" />
            <input type="hidden" name="TotalCompra" id="TotalCompra" value="0" />
            
            <!-- DATOS GENERALES -->
            <div class="space-y-8">
                <!-- CABECERA COMPACTA (UNA SOLA FILA) -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
                        <!-- PROVEEDOR (Col 4) -->
                        <div class="md:col-span-4">
                            <label asp-for="IdProveedor" class="block text-sm font-semibold text-slate-700 mb-2">Proveedor</label>
                            <select asp-for="IdProveedor" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-slate-50">
                            </select>
                            <span asp-validation-for="IdProveedor" class="text-red-500 text-sm mt-1"></span>
                        </div>
                        
                        <!-- NIT / CARNET (Col 3) -->
                        <div class="md:col-span-3">
                             <label class="block text-sm font-semibold text-slate-700 mb-2">NIT / Carnet</label>
                             <input type="text" id="inputNit" readonly class="w-full px-4 py-3 bg-slate-100 border border-slate-300 rounded-lg text-slate-600 focus:ring-0" placeholder="---" />
                        </div>

                         <!-- NRO FACTURA (Col 3) -->
                         <div class="md:col-span-3">
                            <label asp-for="NroFacturaProveedor" class="block text-sm font-semibold text-slate-700 mb-2">Nro. Factura / Recibo</label>
                            <input asp-for="NroFacturaProveedor" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Ej: 123456" />
                            <span asp-validation-for="NroFacturaProveedor" class="text-red-500 text-sm mt-1"></span>
                        </div>

                    </div>
                </div>

                <!-- SECCION INSUMOS (FILA 1) -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-700 mb-4 flex items-center">
                        <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mr-3 text-sm">1</span>
                        Agregar Insumos
                    </h3>
                    <div class="grid grid-cols-12 gap-4 items-end">
                        <div class="col-span-12 md:col-span-4">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Insumo</label>
                            <select id="selectInsumo" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            </select>
                        </div>
                        <div class="col-span-6 md:col-span-2">
                             <label class="block text-sm font-semibold text-slate-700 mb-2">Unidad</label>
                             <div class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-500 text-center font-bold" id="unidadInsumoDisplay">-</div>
                        </div>
                         <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Cantidad</label>
                            <input type="number" id="cantInsumo" step="0.01" min="0.01" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0.00" />
                        </div>
                        <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Precio Compra</label>
                            <input type="number" id="costoInsumo" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0.00" />
                        </div>
                        <div class="col-span-12 md:col-span-2">
                            <button type="button" onclick="agregarInsumo()" class="w-full py-2 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-lg hover:opacity-90 transition-colors shadow-md flex items-center justify-center">
                                <i class="fas fa-plus mr-2"></i> AGREGAR
                            </button>
                        </div>
                    </div>
                </div>

                <!-- SECCION PRODUCTOS (FILA 2) -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-700 mb-4 flex items-center">
                        <span class="w-8 h-8 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mr-3 text-sm">2</span>
                        Agregar Productos
                    </h3>
                    <div class="grid grid-cols-12 gap-4 items-end">
                        <div class="col-span-12 md:col-span-3">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Producto</label>
                            <select id="selectProducto" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            </select>
                        </div>
                        <div class="col-span-6 md:col-span-2">
                             <label class="block text-sm font-semibold text-slate-700 mb-2">Unidad</label>
                             <div class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-500 text-center font-bold" id="unidadProductoDisplay">-</div>
                        </div>
                        <div class="col-span-6 md:col-span-1">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Cant.</label>
                            <input type="number" id="cantProducto" step="1" min="1" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="1" />
                        </div>
                        <!-- PRECIO COMPRA -->
                        <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Precio Compra</label>
                            <input type="number" id="costoProducto" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0.00" title="Precio de Compra (Costo)" />
                        </div>
                        <!-- PRECIO VENTA -->
                        <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Precio de Venta</label>
                            <input type="number" id="precioVentaProducto" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="0.00" title="Precio de Venta al Público" />
                        </div>
                        
                         <div class="col-span-12 md:col-span-2">
                            <button type="button" onclick="agregarProducto()" class="w-full py-2 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-lg hover:opacity-90 transition-colors shadow-md flex items-center justify-center">
                                <i class="fas fa-plus mr-2"></i> AGREGAR
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DETALLE DE COMPRA -->
            <div class="border-t border-slate-200 pt-6">
                <h3 class="text-lg font-semibold text-slate-800 mb-4 px-2">Detalle de la Compra</h3>
                
                <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Tipo</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Ítem</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Cant.</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Precio Compra</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Subtotal</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalles" class="bg-white divide-y divide-slate-200">
                            <tr id="filaVacia">
                                <td colspan="6" class="px-6 py-10 text-center text-slate-400">
                                    <i class="fas fa-shopping-cart text-4xl mb-3 opacity-20"></i>
                                    <p>El carrito está vacío</p>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot class="bg-slate-50 font-bold text-slate-700">
                            <tr>
                                <td colspan="4" class="px-6 py-4 text-right">TOTAL COMPRA:</td>
                                <td class="px-6 py-4 text-primary font-bold text-lg">Bs. <span id="displayTotal">0.00</span></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="flex items-center justify-end space-x-3 mt-8">
                    <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                    <button type="submit" class="px-8 py-3 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-lg shadow-lg hover:opacity-90 transform hover:-translate-y-0.5 transition-all">
                        <i class="fas fa-save mr-2"></i> Registrar Compra
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let detalles = [];
        let tsInsumo, tsProducto;
        // Parsear JSONs proporcionados desde el ViewBag
        const proveedoresData = @Html.Raw(ViewBag.ProveedoresJson ?? "[]");
        const insumosData = @Html.Raw(ViewBag.InsumosJson ?? "[]");
        const productosData = @Html.Raw(ViewBag.ProductosJson ?? "[]");

        document.addEventListener("DOMContentLoaded", function () {
            // Manejo de Proveedor y NIT
            const selectProv = document.getElementById('IdProveedor');
            const inputNit = document.getElementById('DisplayNit'); // Campo dummy para mostrar
            
            // Inicializar TomSelect para Proveedor
            if(selectProv) {
                 new TomSelect('#IdProveedor', {
                    create: false,
                    valueField: 'IdProveedor',
                    labelField: 'Empresa',
                    searchField: ['Empresa', 'NitCarnet'],
                    options: proveedoresData,
                    sortField: { field: "Empresa", direction: "asc" },
                    placeholder: 'Seleccione proveedor',
                    onChange: function(value) {
                        const prov = proveedoresData.find(p => p.IdProveedor == value);
                        if(prov) {
                            if(document.getElementById('inputNit')) document.getElementById('inputNit').value = prov.NitCarnet || 'S/N';
                        } else {
                            if(document.getElementById('inputNit')) document.getElementById('inputNit').value = '';
                        }
                    }
                 });
            }

            // Inicializar TomSelects de Items
            if(document.getElementById('selectInsumo')) {
                tsInsumo = new TomSelect('#selectInsumo', {
                    create: false,
                    valueField: 'IdInsumo',
                    labelField: 'Nombre',
                    searchField: ['Nombre'],
                    options: insumosData,
                    sortField: { field: "Nombre", direction: "asc" },
                    placeholder: 'Buscar insumo...',
                    onChange: function(value) {
                         if (value) {
                            const insumo = insumosData.find(i => i.IdInsumo == value);
                            if(insumo) {
                                document.getElementById('unidadInsumoDisplay').textContent = insumo.Unidad || '';
                                document.getElementById('costoInsumo').value = insumo.CostoPromedio || '';
                            }
                        } else {
                            document.getElementById('unidadInsumoDisplay').textContent = '';
                            document.getElementById('costoInsumo').value = '';
                        }
                    }
                });
            }

            if(document.getElementById('selectProducto')) {
                tsProducto = new TomSelect('#selectProducto', {
                    create: false,
                    valueField: 'IdProducto',
                    labelField: 'Nombre',
                    searchField: ['Nombre'],
                    options: productosData,
                    sortField: { field: "Nombre", direction: "asc" },
                    placeholder: 'Buscar producto...',
                    onChange: function(value) {
                         if (value) {
                            const producto = productosData.find(p => p.IdProducto == value);
                            if(producto) {
                                document.getElementById('unidadProductoDisplay').textContent = producto.Unidad || '';
                                document.getElementById('costoProducto').value = producto.PrecioCompraActual || '';
                                document.getElementById('precioVentaProducto').value = producto.PrecioVenta || '';
                            }
                        } else {
                            document.getElementById('unidadProductoDisplay').textContent = '';
                            document.getElementById('costoProducto').value = '';
                            document.getElementById('precioVentaProducto').value = '';
                        }
                    }
                });
            }
        });

        function mostrarError(mensaje) {
            const alertBox = document.getElementById('customAlert');
            const alertMsg = document.getElementById('customAlertMessage');
            alertMsg.textContent = mensaje;
            alertBox.classList.remove('hidden');
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => { alertBox.classList.add('hidden'); }, 4000);
        }

        // --- FUNCIONES DE AGREGADO ---

        function agregarInsumo() {
            const id = tsInsumo.getValue();
            const cantidad = parseFloat(document.getElementById('cantInsumo').value);
            const costo = parseFloat(document.getElementById('costoInsumo').value);

            if (!id) { mostrarError('Seleccione un insumo.'); return; }
            if (!cantidad || cantidad <= 0) { mostrarError('Ingrese una cantidad válida.'); return; }
            if (isNaN(costo) || costo < 0) { mostrarError('Ingrese un costo válido.'); return; }

            const insumoData = insumosData.find(i => i.IdInsumo == id);
            let nombre = insumoData ? insumoData.Nombre : "Insumo"; 
            if(nombre.includes('(')) nombre = nombre.split('(')[0].trim();
            
            const unidad = insumoData ? insumoData.Unidad : '';

            agregarAlCarrito({
                Tipo: 'Insumo',
                IdInsumo: parseInt(id),
                IdProducto: null,
                Nombre: nombre,
                Unidad: unidad,
                Cantidad: cantidad,
                PrecioUnitario: costo,
                PrecioVentaNuevo: null, // No aplica
                Subtotal: cantidad * costo
            });

            // Limpiar campos
            tsInsumo.clear();
            document.getElementById('cantInsumo').value = '';
            document.getElementById('costoInsumo').value = '';
            document.getElementById('unidadInsumoDisplay').textContent = '';
        }

        function agregarProducto() {
            const id = tsProducto.getValue();
            const cantidad = parseFloat(document.getElementById('cantProducto').value);
            const costo = parseFloat(document.getElementById('costoProducto').value);
            const precioVenta = parseFloat(document.getElementById('precioVentaProducto').value);

            // Validaciones
            if (!id) { mostrarError('Seleccione un producto.'); return; }
            if (!cantidad || cantidad <= 0) { mostrarError('Ingrese una cantidad válida.'); return; }
            if (isNaN(costo) || costo < 0) { mostrarError('Ingrese un costo válido.'); return; }
            // Precio venta puede ser 0 o nulo, pero si se ingresa debe ser valido
            if (precioVenta && precioVenta < 0) { mostrarError('El precio de venta no puede ser negativo.'); return; }

            const productoData = productosData.find(p => p.IdProducto == id);
            let nombre = productoData ? productoData.Nombre : "Producto";
            if(nombre.includes('(')) nombre = nombre.split('(')[0].trim();
            const unidad = productoData ? productoData.Unidad : '';

            agregarAlCarrito({
                Tipo: 'Producto',
                IdInsumo: null,
                IdProducto: parseInt(id),
                Nombre: nombre,
                Unidad: unidad,
                Cantidad: cantidad,
                PrecioUnitario: costo,
                PrecioVentaNuevo: isNaN(precioVenta) ? null : precioVenta,
                Subtotal: cantidad * costo
            });

            // Limpiar campos
            tsProducto.clear();
            document.getElementById('cantProducto').value = '';
            document.getElementById('costoProducto').value = '';
            document.getElementById('precioVentaProducto').value = '';
            document.getElementById('unidadProductoDisplay').textContent = '';
        }

        function agregarAlCarrito(item) {
            const indexExistente = detalles.findIndex(d => 
                d.Tipo === item.Tipo && 
                d.IdInsumo === item.IdInsumo && 
                d.IdProducto === item.IdProducto && 
                d.PrecioUnitario === item.PrecioUnitario
            );

            if (indexExistente !== -1) {
                detalles[indexExistente].Cantidad += item.Cantidad;
                detalles[indexExistente].Subtotal = detalles[indexExistente].Cantidad * detalles[indexExistente].PrecioUnitario;
            } else {
                detalles.push(item);
            }
            actualizarTabla();
        }

        function eliminarDetalle(index) {
            detalles.splice(index, 1);
            actualizarTabla();
        }

        function actualizarTabla() {
            const tbody = document.getElementById('tablaDetalles');
            const filaVacia = document.getElementById('filaVacia');

            const filasDatos = tbody.querySelectorAll('tr:not(#filaVacia)');
            filasDatos.forEach(tr => tr.remove());

            if (detalles.length === 0) {
                filaVacia.style.display = '';
                document.getElementById('displayTotal').innerText = "0";
                return;
            } else {
                filaVacia.style.display = 'none';
            }

            let total = 0;
            detalles.forEach((det, index) => {
                total += det.Subtotal;
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                
                const badgeClass = det.Tipo === 'Insumo' 
                    ? 'bg-blue-100 text-blue-800 border-blue-200' 
                    : 'bg-amber-100 text-amber-800 border-amber-200';

                tr.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 py-1 text-xs font-semibold rounded-full border ${badgeClass}">
                            ${det.Tipo}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-700">${det.Nombre}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                        ${det.Cantidad} <span class="text-xs font-bold text-slate-400">${det.Unidad || ''}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">Bs. ${det.PrecioUnitario.toFixed(2).replace(/\.00$/, '')}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-700">Bs. ${det.Subtotal.toFixed(2).replace(/\.00$/, '')}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                        <button type="button" onclick="eliminarDetalle(${index})" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-100 hover:bg-red-600 text-red-600 hover:text-white font-semibold rounded-lg border border-red-300 hover:border-red-600 transition-all duration-200 shadow-sm">
                            <i class="fas fa-trash-alt text-xs"></i>
                            <span class="text-xs">Quitar</span>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('displayTotal').innerText = total.toFixed(2).replace(/\.00$/, '');
        }

        // --- SUBMIT ---
        document.getElementById('formCompra').addEventListener('submit', function (e) {
            if (detalles.length === 0) {
                e.preventDefault();
                mostrarError('Debe agregar al menos un ítem a la compra.');
                return;
            }
            const total = detalles.reduce((sum, d) => sum + d.Subtotal, 0);
            document.getElementById('TotalCompra').value = total.toFixed(2).replace(',', '.');
            document.getElementById('detallesJson').value = JSON.stringify(detalles);
        });

    </script>
}
