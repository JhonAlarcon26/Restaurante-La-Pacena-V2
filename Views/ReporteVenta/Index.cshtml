@model la_paceña_v2.Models.ViewModels.FiltroReporteVentasViewModel

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="animate-in fade-in slide-in-from-left duration-700">
            <h1 class="text-4xl font-black text-slate-900 tracking-tight">Reporte de Ventas</h1>
            <p class="text-slate-500 mt-2 font-medium">Análisis detallado de ingresos y transacciones comerciales</p>
        </div>
        <div class="flex gap-3 animate-in fade-in slide-in-from-right duration-700">
            @if (User.HasClaim("Permiso", "VerReporteVentas"))
            {
            <button type="submit" form="formFiltros" formaction="@Url.Action("ExportarExcel")" formmethod="post" 
                    class="inline-flex items-center px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-2xl shadow-lg shadow-emerald-200 transition-all hover:scale-105 active:scale-95 group">
                <i class="fas fa-file-excel mr-2 transition-transform group-hover:rotate-12"></i>
                Excel
            </button>
            <button type="submit" form="formFiltros" formaction="@Url.Action("ExportarPDF")" formmethod="post" 
                    class="inline-flex items-center px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold rounded-2xl shadow-lg shadow-rose-200 transition-all hover:scale-105 active:scale-95 group">
                <i class="fas fa-file-pdf mr-2 transition-transform group-hover:rotate-12"></i>
                PDF
            </button>
            }
        </div>
    </div>

    <!-- Filtros -->
    <div class="bg-white/80 backdrop-blur-md rounded-3xl shadow-xl border border-slate-200 p-8 mb-10 animate-in zoom-in duration-500">
        <form asp-action="Index" method="get" id="formFiltros" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 ml-1">Fecha Inicio</label>
                    <input type="date" asp-for="FechaInicio" class="w-full px-4 py-3 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 transition-all text-slate-700 font-semibold shadow-inner" />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 ml-1">Fecha Fin</label>
                    <input type="date" asp-for="FechaFin" class="w-full px-4 py-3 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 transition-all text-slate-700 font-semibold shadow-inner" />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 ml-1">Restaurante</label>
                    <select asp-for="IdRestaurante" asp-items="ViewBag.Restaurantes" class="tom-select w-full px-4 py-3 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 transition-all text-slate-700 font-semibold shadow-inner">
                        <option value="">Todas las Restaurantes</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 ml-1">Cajero/Usuario</label>
                    <select asp-for="IdUsuario" asp-items="ViewBag.Usuarios" class="tom-select w-full px-4 py-3 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 transition-all text-slate-700 font-semibold shadow-inner">
                        <option value="">Todos los usuarios</option>
                    </select>
                </div>
            </div>
            <div class="flex justify-end pt-2">
                <button type="submit" class="inline-flex items-center px-10 py-4 bg-slate-900 hover:bg-black text-white font-black rounded-2xl shadow-xl transition-all hover:scale-105 active:scale-95 group">
                    <i class="fas fa-search mr-3 group-hover:rotate-12 transition-transform"></i>
                    Filtrar Resultados
                </button>
            </div>
        </form>
    </div>

    @if (Model.Reporte != null)
    {
        <!-- KPIs -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div class="bg-gradient-to-br from-white to-amber-50 rounded-3xl shadow-xl p-8 border border-white transition-transform hover:scale-[1.02] duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-amber-600 font-bold text-sm uppercase tracking-wider mb-1">Ventas Totales</p>
                        <p class="text-4xl font-black text-slate-900 tracking-tight">Bs. @Model.Reporte.TotalVentas.ToString("#,##0.##")</p>
                    </div>
                    <div class="w-16 h-16 bg-amber-500/10 rounded-2xl flex items-center justify-center text-amber-600">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>
            <div class="bg-gradient-to-br from-white to-slate-50 rounded-3xl shadow-xl p-8 border border-white transition-transform hover:scale-[1.02] duration-300">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-slate-500 font-bold text-sm uppercase tracking-wider mb-1">Transacciones</p>
                        <p class="text-4xl font-black text-slate-900 tracking-tight">@Model.Reporte.CantidadTransacciones</p>
                    </div>
                    <div class="w-16 h-16 bg-slate-500/10 rounded-2xl flex items-center justify-center text-slate-600">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in slide-in-from-bottom duration-1000">
            <div class="overflow-x-auto min-h-[400px]">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/50">
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100">Fecha</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100">Cliente</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100 text-center">Ítems</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100">Restaurante</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100">Cajero</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100">Estado</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100 text-right">Total</th>
                            <th class="px-6 py-5 text-xs font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Reporte.Detalles)
                        {
                            <tr class="hover:bg-amber-50/30 transition-all group">
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-bold text-slate-900">@item.Fecha.ToString("dd/MM/yyyy")</span>
                                        <span class="text-[11px] font-medium text-slate-400">@item.Fecha.ToString("HH:mm")</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-semibold text-slate-700">@item.Cliente</span>
                                        <span class="text-[11px] font-medium text-slate-400">@item.TipoPago</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center justify-center px-2.5 py-1 text-xs font-bold rounded-lg bg-amber-50 text-amber-700 border border-amber-100">
                                        @item.CantidadItems
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm font-medium text-slate-600">@item.Restaurante</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm font-medium text-slate-600">@item.Usuario</span>
                                </td>
                                <td class="px-6 py-4">
                                    @{
                                        var statusClass = item.Estado == "ANULADO" ? "bg-rose-50 text-rose-600 border-rose-100" : "bg-emerald-50 text-emerald-600 border-emerald-100";
                                    }
                                    <span class="px-3 py-1 text-[11px] font-bold rounded-full border @statusClass uppercase tracking-tighter">
                                        @item.Estado
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <span class="text-sm font-black text-slate-900">Bs. @item.Total.ToString("#,##0.##")</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex justify-center">
                                        <button onclick="verDetalle(@item.IdTransaccion)" 
                                                class="p-2 text-slate-400 hover:text-amber-600 bg-slate-100 hover:bg-amber-100 rounded-xl transition-all duration-300 hover:scale-110 active:scale-95 group/btn">
                                            <svg class="w-5 h-5 transition-transform group-hover/btn:rotate-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Reporte.Detalles.Any())
            {
                <div class="p-20 text-center">
                    <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 mb-2">No se encontraron ventas</h3>
                    <p class="text-slate-500">Intenta cambiar los filtros de fecha o Restaurante.</p>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Detalle -->
<div id="modalDetalle" class="fixed inset-0 z-[60] hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 transition-opacity bg-slate-900/60 backdrop-blur-sm" onclick="cerrarModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full animate-in zoom-in duration-300">
            <div id="contenidoModal">
                <!-- Se carga vía AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalle(id) {
            const modal = document.getElementById('modalDetalle');
            const contenido = document.getElementById('contenidoModal');
            
            modal.classList.remove('hidden');
            contenido.innerHTML = `
                <div class="p-20 text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-amber-600 mx-auto"></div>
                    <p class="mt-4 text-slate-500 font-medium italic">Obteniendo detalles de la venta...</p>
                </div>
            `;

            fetch(`@Url.Action("Detalle", "ReporteVenta")/${id}`)
                .then(r => r.text())
                .then(html => {
                    contenido.innerHTML = html;
                });
        }

        function cerrarModal() {
            document.getElementById('modalDetalle').classList.add('hidden');
        }

        document.querySelectorAll('tbody tr').forEach((tr, index) => {
            tr.style.opacity = '0';
            tr.style.transform = 'translateY(10px)';
            setTimeout(() => {
                tr.style.transition = 'all 0.4s ease-out';
                tr.style.opacity = '1';
                tr.style.transform = 'translateY(0)';
            }, 50 * index);
        });
    </script>
}
