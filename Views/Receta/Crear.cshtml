@model la_paceña_v2.Services.DTOs.RecetaDTO

@{
    ViewData["Title"] = "Gestión de Recetas";
}

<div class="max-w-2xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Recetas
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Agregar Ingredientes</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary to-secondary px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Gestionar Receta</h2>
            <p class="text-blue-100 mt-1">Agrega múltiples ingredientes a un plato</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mx-6 mt-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded">
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="font-semibold">@TempData["Error"]</span>
                </div>
            </div>
        }

        <!-- Custom Alert for Validation -->
        <div id="customAlert" class="hidden mx-6 mt-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded shadow-md transition-all duration-300">
            <div class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <h3 class="font-bold">Error de Validación</h3>
                    <p id="customAlertMessage">Mensaje de error</p>
                </div>
                <button onclick="cerrarAlert()" class="ml-auto text-red-500 hover:text-red-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <form asp-action="Crear" method="post" id="formReceta" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" id="DetallesJson" name="DetallesJson" />

            <div class="mb-8">
                <label asp-for="IdPlato" class="block text-2xl font-bold text-slate-800 mb-4">
                    Seleccione el Plato <span class="text-red-500">*</span>
                </label>
                <select asp-for="IdPlato" asp-items="ViewBag.Platos" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent text-lg">
                    <option value="">Seleccione un plato...</option>
                </select>
                <p class="mt-2 text-slate-500">Seleccione el plato al que desea agregar o modificar sus ingredientes.</p>
            </div>

            <div class="border-t border-slate-200 pt-6">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Agregar Ingredientes</h3>
                
                <div class="grid grid-cols-12 gap-3 mb-3 bg-slate-50 p-4 rounded-lg border border-slate-200">
                    <div class="col-span-12 md:col-span-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Insumo</label>
                        <select id="selectInsumo" class="tom-select w-full">
                            <option value="">Seleccione insumo...</option>
                            @if (ViewBag.Insumos != null)
                            {
                                foreach (var insumo in (dynamic)ViewBag.Insumos)
                                {
                                    <option value="@insumo.IdInsumo" data-unidad="@insumo.Unidad">@insumo.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-span-12 md:col-span-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Cantidad Requerida</label>
                        <div class="relative">
                            <input type="number" id="inputCantidad" step="0.001" min="0.001" placeholder="Ej: 0.5" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent pr-16" />
                            <div id="unidadInputDisplay" class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400 font-bold text-xs uppercase tracking-widest">
                                ---
                            </div>
                        </div>
                    </div>
                    <div class="col-span-12 md:col-span-2 flex items-end">
                        <button type="button" onclick="agregarDetalle()" class="w-full px-4 py-2 bg-gradient-to-r from-primary to-secondary text-white font-medium rounded-lg hover:opacity-90 transition-colors shadow-sm">
                            <span class="flex items-center justify-center">
                                <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                Agregar
                            </span>
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-lg border border-slate-200 mt-4">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Insumo</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Cantidad</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Unidad</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold text-slate-700 uppercase tracking-wider">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalles" class="bg-white divide-y divide-slate-200">
                            <tr id="filaVacia">
                                <td colspan="4" class="px-6 py-10 text-center text-slate-500">
                                    <div class="flex flex-col items-center justify-center">
                                        <svg class="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                        <p>No hay ingredientes agregados</p>
                                        <p class="text-sm">Agregue insumos desde el formulario superior</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-slate-200">
                    <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                    <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                        Guardar Receta
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let detalles = [];
        let tsInsumo = null;

        // Helper para mostrar error
        function mostrarError(mensaje) {
            const alertBox = document.getElementById('customAlert');
            const alertMsg = document.getElementById('customAlertMessage');
            alertMsg.textContent = mensaje;
            alertBox.classList.remove('hidden');
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 5000);
        }

        window.cerrarAlert = function() {
            document.getElementById('customAlert').classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar TomSelects
            const selectInsumo = document.getElementById('selectInsumo');
            const unidadInputDisplay = document.getElementById('unidadInputDisplay');

            function formatNumberInput(input) {
                input.addEventListener('blur', function() {
                    if (this.value) {
                        let val = parseFloat(this.value);
                        if (val === Math.floor(val)) {
                            this.value = val.toFixed(0);
                        } else {
                            this.value = val.toString();
                        }
                    }
                });
            }

            const inputCantidad = document.getElementById('inputCantidad');
            if (inputCantidad) formatNumberInput(inputCantidad);

            // Wait a bit for layout JS to init TomSelects
            setTimeout(() => {
                const el = document.getElementById('selectInsumo');
                if (el && el.tomselect) {
                    tsInsumo = el.tomselect;
                    
                    tsInsumo.on('change', function(value) {
                        if (value) {
                            const option = el.querySelector(`option[value="${value}"]`);
                            const unidad = option ? option.getAttribute('data-unidad') : '---';
                            unidadInputDisplay.textContent = unidad;
                            unidadInputDisplay.classList.remove('text-slate-400');
                            unidadInputDisplay.classList.add('text-primary');
                        } else {
                            unidadInputDisplay.textContent = '---';
                            unidadInputDisplay.classList.remove('text-primary');
                            unidadInputDisplay.classList.add('text-slate-400');
                        }
                    });
                }
            }, 100);
        });

        function agregarDetalle() {
            const selectEl = document.getElementById('selectInsumo');
            const inputCantidad = document.getElementById('inputCantidad');
            
            const idInsumo = parseInt(selectEl.value);
            let nombreInsumo = '';
            let unidadInsumo = '';
            
            // Get data
            if (tsInsumo) {
                const option = tsInsumo.options[idInsumo];
                if (option) {
                    nombreInsumo = option.text;
                    // En TomSelect la data custom no siempre viaja al objeto option de la misma forma
                    // Buscamos el elemento original
                    const nativeOption = selectEl.querySelector(`option[value="${idInsumo}"]`);
                    unidadInsumo = nativeOption ? nativeOption.getAttribute('data-unidad') : '';
                }
            }

            const cantidad = parseFloat(inputCantidad.value);

            // Validations
            if (!idInsumo) {
                mostrarError('Debe seleccionar un insumo');
                return;
            }
            if (!cantidad || cantidad <= 0) {
                mostrarError('La cantidad debe ser mayor a 0');
                inputCantidad.focus();
                return;
            }

            // Check duplicate
            const index = detalles.findIndex(d => d.IdInsumo === idInsumo);
            if (index !== -1) {
                detalles[index].Cantidad += cantidad; // Accumulate or overwrite? Usually accumulate in UI
            } else {
                detalles.push({
                    IdInsumo: idInsumo,
                    Cantidad: cantidad,
                    _nombre: nombreInsumo,
                    _unidad: unidadInsumo
                });
            }

            actualizarTabla();
            
            // Clear inputs
            if (tsInsumo) {
                tsInsumo.clear();
            } else {
                selectEl.value = '';
            }
            document.getElementById('unidadInputDisplay').textContent = '---';
            document.getElementById('unidadInputDisplay').classList.remove('text-primary');
            document.getElementById('unidadInputDisplay').classList.add('text-slate-400');
            inputCantidad.value = '';
            inputCantidad.focus();
        }

        function eliminarDetalle(index) {
            detalles.splice(index, 1);
            actualizarTabla();
        }

        function actualizarTabla() {
            const tbody = document.getElementById('tablaDetalles');
            const filaVacia = document.getElementById('filaVacia');
            
            // Remove data rows
            const rows = tbody.querySelectorAll('tr:not(#filaVacia)');
            rows.forEach(r => r.remove());

            if (detalles.length === 0) {
                filaVacia.style.display = '';
                return;
            }

            filaVacia.style.display = 'none';

            detalles.forEach((det, index) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition-colors';
                tr.innerHTML = `
                    <td class="px-6 py-4 text-sm font-medium text-slate-800">${det._nombre}</td>
                    <td class="px-6 py-4 text-sm text-slate-600">${det.Cantidad}</td>
                    <td class="px-6 py-4 text-sm font-bold text-primary uppercase tracking-widest">${det._unidad || '---'}</td>
                    <td class="px-6 py-4 text-right">
                        <button type="button" onclick="eliminarDetalle(${index})" class="text-red-600 hover:text-red-900 font-medium text-sm inline-flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Quitar
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        document.getElementById('formReceta').addEventListener('submit', function(e) {
            const idPlato = document.getElementById('IdPlato').value;
            
            if (!idPlato) {
                e.preventDefault();
                mostrarError('Debe seleccionar un plato');
                return;
            }

            if (detalles.length === 0) {
                e.preventDefault();
                mostrarError('Debe agregar al menos un ingrediente a la receta');
                return;
            }

            document.getElementById('DetallesJson').value = JSON.stringify(detalles);
        });
    </script>
}
