@model UnidadDeMedida
@{ ViewData["Title"] = "Eliminar Unidad"; }
<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg border overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-600 px-6 py-4"><h2 class="text-2xl font-bold text-white">Confirmar Eliminación</h2></div>
        <div class="p-6">
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6"><p class="text-red-700"><strong>Advertencia:</strong> Esta acción no se puede deshacer.</p></div>
            <dl class="space-y-3"><div class="flex justify-between py-2 border-b"><dt class="font-medium">Nombre:</dt><dd>@Model.Nombre</dd></div><div class="flex justify-between py-2 border-b"><dt class="font-medium">Abreviatura:</dt><dd>@Model.Abreviatura</dd></div></dl>
        </div>
        <div class="bg-slate-50 px-6 py-4 border-t">
            <form asp-action="Eliminar" class="flex justify-between">
                <input type="hidden" asp-for="IdUnidad" />
                <a asp-action="Listar" class="px-6 py-3 bg-white border rounded-lg">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white rounded-lg shadow-lg">Eliminar</button>
            </form>
        </div>
    </div>
</div>
