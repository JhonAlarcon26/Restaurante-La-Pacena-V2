@model List<la_paceña_v2.Services.DTOs.ReporteStockDTO>

@{
    ViewData["Title"] = "Control de Stock";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="animate-in fade-in slide-in-from-left duration-700">
            <h1 class="text-4xl font-black text-slate-900 tracking-tight">Reporte de Stock</h1>
            <p class="text-slate-500 mt-2 font-medium">Estado actual del stock consolidado y valoración de activos</p>
        </div>
        <div class="flex gap-3 animate-in fade-in slide-in-from-right duration-700">
            @if (User.HasClaim("Permiso", "VerReporteStock"))
            {
            <button type="submit" form="formFiltros" formaction="@Url.Action("ExportarExcel")" formmethod="post" 
                    class="inline-flex items-center px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-2xl shadow-lg shadow-emerald-200 transition-all hover:scale-105 active:scale-95 group">
                <svg class="w-5 h-5 mr-2 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Excel
            </button>
            <button type="submit" form="formFiltros" formaction="@Url.Action("ExportarPDF")" formmethod="post" 
                    class="inline-flex items-center px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold rounded-2xl shadow-lg shadow-rose-200 transition-all hover:scale-105 active:scale-95 group">
                <svg class="w-5 h-5 mr-2 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                PDF
            </button>
            }
        </div>
    </div>

    <!-- Filtros -->
    <div class="bg-white/80 backdrop-blur-md rounded-3xl shadow-xl border border-slate-200 p-8 mb-10 animate-in zoom-in duration-500">
        <form method="get" id="formFiltros" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-3">
                    <label class="text-sm font-bold text-slate-700 ml-1 flex items-center">
                        <i class="fas fa-filter mr-2 text-blue-500"></i>
                        Filtrar por Tipo
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-500 transition-colors">
                            <i class="fas fa-tag"></i>
                        </div>
                        <select name="tipo" class="w-full pl-11 pr-4 py-3.5 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 transition-all text-slate-700 font-bold shadow-inner appearance-none cursor-pointer">
                            @if (string.IsNullOrEmpty(ViewBag.Tipo as string)) { <option value="" selected>Todos los Items</option> } else { <option value="">Todos los Items</option> }
                            @if (ViewBag.Tipo == "INSUMO") { <option value="INSUMO" selected>Solo Insumos</option> } else { <option value="INSUMO">Solo Insumos</option> }
                            @if (ViewBag.Tipo == "PRODUCTO") { <option value="PRODUCTO" selected>Solo Productos</option> } else { <option value="PRODUCTO">Solo Productos</option> }
                            @if (ViewBag.Tipo == "PLATO") { <option value="PLATO" selected>Solo Platos</option> } else { <option value="PLATO">Solo Platos</option> }
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-300">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <label class="text-sm font-bold text-slate-700 ml-1 flex items-center">
                        <i class="fas fa-signal mr-2 text-emerald-500"></i>
                        Estado de Stock
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-500 transition-colors">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <select name="estado" class="w-full pl-11 pr-4 py-3.5 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-emerald-500 transition-all text-slate-700 font-bold shadow-inner appearance-none cursor-pointer">
                            @if (string.IsNullOrEmpty(ViewBag.Estado as string)) { <option value="" selected>Cualquier Estado</option> } else { <option value="">Cualquier Estado</option> }
                            @if (ViewBag.Estado == "Bajo") { <option value="Bajo" selected>Stock Bajo (Alerta)</option> } else { <option value="Bajo">Stock Bajo (Alerta)</option> }
                            @if (ViewBag.Estado == "Normal") { <option value="Normal" selected>Stock Normal</option> } else { <option value="Normal">Stock Normal</option> }
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-300">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex justify-end pt-2">
                <button type="submit" class="inline-flex items-center px-10 py-4 bg-slate-900 hover:bg-black text-white font-black rounded-2xl shadow-xl transition-all hover:scale-105 active:scale-95 group">
                    <svg class="w-5 h-5 mr-3 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Aplicar Filtros
                </button>
            </div>
        </form>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl shadow-xl p-8 border border-blue-500/20 text-white transition-transform hover:scale-[1.03] duration-300 group">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-blue-100 font-bold text-xs uppercase tracking-widest mb-1">Valoración Total</p>
                    <p class="text-3xl font-black tracking-tight">Bs. @Model.Sum(x => x.ValorTotal).ToString("#,##0.##")</p>
                </div>
                <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center text-white backdrop-blur-md group-hover:rotate-6 transition-transform">
                    <i class="fas fa-coins text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-3xl shadow-xl p-8 border border-slate-100 transition-transform hover:scale-[1.03] duration-300 group">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 font-bold text-xs uppercase tracking-widest mb-1">Items Totales</p>
                    <p class="text-3xl font-black text-slate-800 tracking-tight">@Model.Count</p>
                </div>
                <div class="w-14 h-14 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-400 border border-slate-100 group-hover:rotate-6 transition-transform">
                    <i class="fas fa-list-ul text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-rose-50 to-white rounded-3xl shadow-xl p-8 border border-rose-100 transition-transform hover:scale-[1.03] duration-300 group">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-rose-600 font-bold text-xs uppercase tracking-widest mb-1">Alertas Críticas</p>
                    <p class="text-3xl font-black text-rose-700 tracking-tight">@Model.Count(x => x.EstadoStock == "Bajo")</p>
                </div>
                <div class="w-14 h-14 bg-rose-600/10 rounded-2xl flex items-center justify-center text-rose-600 group-hover:animate-pulse">
                    <i class="fas fa-exclamation-triangle text-2xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in slide-in-from-bottom duration-1000">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100">Tipo</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100">Descripción del Item</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-center">U.M.</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-right">Stock Actual</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-right">Mínimo</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-right">Costo Prom.</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-right">Valor Total</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-center">Estado</th>
                        <th class="px-6 py-5 text-[11px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-all group">
                            <td class="px-6 py-4">
                                @if (item.Tipo == "INSUMO")
                                {
                                    <span class="px-2.5 py-1 text-[10px] font-black uppercase rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-100">Insumo</span>
                                }
                                else if (item.Tipo == "PRODUCTO")
                                {
                                    <span class="px-2.5 py-1 text-[10px] font-black uppercase rounded-lg bg-amber-50 text-amber-700 border border-amber-100">Producto</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 text-[10px] font-black uppercase rounded-lg bg-rose-50 text-rose-700 border border-rose-100">Plato</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-bold text-slate-800">@item.Nombre</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="text-xs font-medium text-slate-500">@item.Unidad</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <span class="text-sm font-black @(item.EstadoStock == "Bajo" ? "text-rose-600 animate-pulse" : "text-emerald-600")">
                                    @item.StockActual.ToString("#,##0.##")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <span class="text-xs font-medium text-slate-400">@item.StockMinimo.ToString("#,##0.##")</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <span class="text-sm font-medium text-slate-600">Bs. @item.CostoPromedio.ToString("#,##0.##")</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <span class="text-sm font-black text-slate-900">Bs. @item.ValorTotal.ToString("#,##0.##")</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (item.EstadoStock == "Bajo")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-[10px] font-black uppercase border border-rose-200">
                                        <span class="w-1.5 h-1.5 bg-rose-600 rounded-full animate-ping"></span>
                                        Bajo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-black uppercase border border-emerald-200">
                                        <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full"></span>
                                        Normal
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                <button onclick="verDetalle('@item.Tipo', '@item.Nombre')" 
                                        class="inline-flex items-center justify-center w-10 h-10 bg-slate-100 hover:bg-slate-900 text-slate-600 hover:text-white rounded-xl transition-all duration-300 hover:scale-110 active:scale-95 border border-slate-200 hover:border-slate-800 group/btn shadow-sm hover:shadow-indigo-200/50">
                                    <i class="fas fa-eye text-base transition-transform group-hover/btn:scale-110"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="p-20 text-center">
                <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-layer-group text-4xl text-slate-300"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">Sin registros de stock</h3>
                <p class="text-slate-500">No se encontraron items con los filtros aplicados.</p>
            </div>
        }
    </div>
</div>

<!-- Modal de Detalle -->
<div id="modalDetalle" class="fixed inset-0 z-[60] hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="cerrarModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full animate-in fade-in zoom-in duration-300">
            <div id="contenidoDetalle">
                <!-- Contenido dinámico -->
                <div class="p-20 text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-indigo-600 border-t-transparent mx-auto"></div>
                </div>
            </div>
            <div class="bg-slate-50 px-8 py-4 flex justify-end gap-3 border-t border-slate-100">
                <button type="button" onclick="cerrarModal()" class="px-6 py-2.5 bg-white border border-slate-200 text-slate-600 font-bold rounded-xl hover:bg-slate-50 transition-all active:scale-95">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalle(tipo, nombre) {
            const modal = document.getElementById('modalDetalle');
            const contenido = document.getElementById('contenidoDetalle');
            
            modal.classList.remove('hidden');
            contenido.innerHTML = `
                <div class="p-20 text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-indigo-600 border-t-transparent mx-auto"></div>
                </div>
            `;

            fetch(`@Url.Action("Detalle", "ReporteStock")?tipo=${tipo}&nombre=${encodeURIComponent(nombre)}`)
                .then(response => response.text())
                .then(html => {
                    contenido.innerHTML = `<div class="p-8">${html}</div>`;
                })
                .catch(error => {
                    contenido.innerHTML = `
                        <div class="p-20 text-center text-rose-600">
                            <i class="fas fa-exclamation-circle text-4xl mb-4"></i>
                            <p class="font-bold">Error al cargar el detalle</p>
                        </div>
                    `;
                });
        }

        function cerrarModal() {
            document.getElementById('modalDetalle').classList.add('hidden');
        }

        // Animación de entrada para las filas
        document.querySelectorAll('tbody tr').forEach((tr, index) => {
            tr.style.opacity = '0';
            tr.style.transform = 'translateY(10px)';
            setTimeout(() => {
                tr.style.transition = 'all 0.4s ease-out';
                tr.style.opacity = '1';
                tr.style.transform = 'translateY(0)';
            }, 40 * index);
        });
    </script>
}
