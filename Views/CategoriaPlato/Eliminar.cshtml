@model la_paceña_v2.Models.CategoriaPlato

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Categorías
                </a>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="ml-1 text-sm font-medium text-slate-500 md:ml-2">Eliminar</span>
                </div>
            </li>
        </ol>
    </nav>

    <!-- Warning Card -->
    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-500 to-rose-600 px-6 py-6">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <svg class="h-12 w-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <h2 class="text-2xl font-bold text-white">Confirmar Eliminación</h2>
                    <p class="text-red-100 mt-1">Esta acción no se puede deshacer</p>
                </div>
            </div>
        </div>

        <!-- Alert -->
        <div class="p-6">
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700">
                            <strong>Advertencia:</strong> Al eliminar esta categoría, los platos asociados podrían perder su clasificación. Asegúrese de que no hay platos vinculados antes de continuar.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Category Details -->
            <div class="bg-slate-50 rounded-lg p-6 border border-slate-200">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Detalles de la Categoría a Eliminar</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div class="flex items-center justify-between py-3 border-b border-slate-200">
                        <dt class="text-sm font-medium text-slate-600">Nombre</dt>
                        <dd class="text-sm font-semibold text-slate-900">@Model.Nombre</dd>
                    </div>
                    <div class="flex items-center justify-between py-3 border-b border-slate-200">
                        <dt class="text-sm font-medium text-slate-600">Impresora Destino</dt>
                        <dd class="text-sm font-semibold text-slate-900">@(Model.ImpresoraDestino ?? "No asignada")</dd>
                    </div>
                    <div class="flex items-center justify-between py-3">
                        <dt class="text-sm font-medium text-slate-600">Estado</dt>
                        <dd>
                            @if (Model.Estado == true)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    Inactivo
                                </span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Actions -->
        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200">
            <form asp-action="Eliminar" class="flex items-center justify-between">
                <input type="hidden" asp-for="IdCategoria" />
                <a asp-action="Listar" 
                   class="inline-flex items-center px-6 py-3 bg-white border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-all duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Cancelar
                </a>
                <button type="submit" 
                        class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Confirmar Eliminación
                </button>
            </form>
        </div>
    </div>
</div>
