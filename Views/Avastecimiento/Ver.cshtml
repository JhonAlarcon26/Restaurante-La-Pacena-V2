@model la_paceña_v2.Models.Avastecimiento

@{
    string fFecha = Model.FechaAvastecimiento.HasValue ? Model.FechaAvastecimiento.Value.ToString("dd-MM-yyyy") : "SinFecha";
    ViewData["Title"] = $"Avastecimiento_Nro_{Model.IdAvastecimiento}_{fFecha}"; ViewData["PrintMode"] = true;
    ViewData["PrintMode"] = true;
}

<style>
    @@media print {
        @@page {
            margin: 1cm;
        }
        body {
            padding: 0 !important;
            background-color: white !important;
            color: black !important;
        }
        /* Forzar blanco y negro puro para ahorrar tinta */
        * {
            color: black !important;
            background: transparent !important;
            box-shadow: none !important;
            text-shadow: none !important;
            border-color: #000 !important;
        }
        header, aside, nav, .main-header, .main-sidebar, .sidebar, .print\:hidden {
            display: none !important;
        }
        .content-wrapper, main {
            margin-left: 0 !important;
            padding-top: 0 !important;
            background-color: white !important;
        }
        table { page-break-inside: auto; border-collapse: collapse !important; width: 100% !important; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; page-break-after: auto; }
        th, td { border-bottom: 1px solid #000 !important; padding: 8px !important; }
        .bg-gradient-to-r { border-bottom: 2px solid #000 !important; }
        .grid > div { page-break-inside: avoid; border: 1px solid #000 !important; margin-bottom: 10px !important; }
        .badge, span.inline-flex, span.px-2 { border: 1px solid #000 !important; }
    }
</style>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 print:py-0 print:px-0">
    <div class="mb-6 print:mb-2 flex items-center justify-between">
        <div>
            <h1 class="text-3xl print:text-xl font-bold text-slate-800">Detalle de Abastecimiento #@Model.IdAvastecimiento</h1>
            <p class="text-slate-500 mt-1 print:mt-0 print:text-sm">Registrado el @(Model.FechaAvastecimiento?.ToString("dd/MM/yyyy HH:mm"))</p>
        </div>
        <div class="flex space-x-3 print:hidden">
             <a asp-action="Listar" class="bg-white border border-slate-300 text-slate-700 font-semibold py-2 px-4 rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Volver
            </a>
            <button onclick="window.print()" class="bg-slate-800 text-white font-semibold py-2 px-4 rounded-lg shadow-md hover:bg-slate-900 transition-colors flex items-center">
                 <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                 Imprimir
            </button>
        </div>
    </div>

    <div class="bg-white shadow-lg print:shadow-none rounded-xl overflow-hidden border border-slate-200 print:border-none">
        <div class="bg-gradient-to-r from-primary to-secondary px-8 py-6 print:px-4 print:py-3 text-white flex justify-between items-center">
             <div>
                 <h2 class="text-2xl print:text-lg font-bold">Resumen de Abastecimiento</h2>
                 <p class="text-purple-100 print:text-xs opacity-90 mt-1 print:mt-0">Factura/Recibo: @(string.IsNullOrEmpty(Model.NroFacturaProveedor) ? "S/N" : Model.NroFacturaProveedor)</p>
             </div>
             <div class="text-right">
                 <p class="text-purple-200 text-sm print:text-xs font-semibold uppercase tracking-wider">Total Abastecimiento</p>
                 <p class="text-4xl print:text-2xl font-bold">Bs. @Model.TotalAvastecimiento.ToString("#,##0.##")</p>
             </div>
        </div>

        <div class="p-8 print:p-2">
            <div class="grid grid-cols-1 md:grid-cols-2 print:grid-cols-2 gap-8 print:gap-4 mb-8 print:mb-4">
                <div class="bg-slate-50 rounded-xl p-6 print:p-3 border border-slate-100">
                     <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 print:mb-2 flex items-center">
                         <svg class="w-5 h-5 print:w-4 print:h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                         Datos del Proveedor
                     </h3>
                     <div class="space-y-3 print:space-y-1">
                         <div>
                             <p class="text-sm print:text-xs text-slate-500">Empresa / Nombre</p>
                             <p class="text-lg print:text-sm font-semibold text-slate-800">@(Model.IdProveedorNavigation?.NombreEmpresa ?? "Suministro Interno")</p>
                         </div>
                         <div>
                             <p class="text-sm print:text-xs text-slate-500">NIT / Carnet</p>
                             <p class="text-base print:text-sm font-medium text-slate-700">@(string.IsNullOrEmpty(Model.IdProveedorNavigation?.NitCarnet) ? "---" : Model.IdProveedorNavigation.NitCarnet)</p>
                         </div>
                     </div>
                </div>

                <div class="bg-slate-50 rounded-xl p-6 print:p-3 border border-slate-100">
                     <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 print:mb-2 flex items-center">
                         <svg class="w-5 h-5 print:w-4 print:h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                         Datos de Registro
                     </h3>
                     <div class="space-y-3 print:space-y-1">
                         <div>
                             <p class="text-sm print:text-xs text-slate-500">Registrado Por</p>
                             <p class="text-sm font-semibold text-gray-900">@Model.IdUsuarioNavigation?.Nombre</p>
                         </div>
                         <div>
                             <p class="text-sm print:text-xs text-slate-500">Estado de la Transacción</p>
                             <span class="inline-flex items-center px-3 py-1 print:px-2 print:py-0.5 mt-1 rounded-full text-sm print:text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                                 Completado
                             </span>
                         </div>
                     </div>
                </div>
            </div>

            <div>
                 <h3 class="text-lg print:text-base font-bold text-slate-800 mb-4 print:mb-2 px-2 border-b border-slate-200 pb-2">Artículos Abastecidos</h3>
                 
                 <div class="overflow-hidden rounded-lg border border-slate-200 shadow-sm print:shadow-none">
                     <table class="min-w-full divide-y divide-slate-200">
                         <thead class="bg-slate-50">
                             <tr>
                                 <th class="px-6 py-3 print:px-3 print:py-2 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Tipo</th>
                                 <th class="px-6 py-3 print:px-3 print:py-2 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Ítem</th>
                                 <th class="px-6 py-3 print:px-3 print:py-2 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">Cantidad</th>
                                 <th class="px-6 py-3 print:px-3 print:py-2 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">Precio Compra</th>
                                 <th class="px-6 py-3 print:px-3 print:py-2 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">Subtotal</th>
                             </tr>
                         </thead>
                         <tbody class="bg-white divide-y divide-slate-200 print:text-sm">
                             @if (Model.DetalleAvastecimiento != null && Model.DetalleAvastecimiento.Any())
                             {
                                 foreach (var det in Model.DetalleAvastecimiento)
                                 {
                                     <tr class="hover:bg-slate-50 transition-colors">
                                         <td class="px-6 py-4 print:px-3 print:py-2 whitespace-nowrap">
                                             <span class="px-2 py-1 print:px-1 print:py-0 print:border-none print:bg-transparent print:text-slate-800 text-xs font-semibold rounded-full border bg-amber-100 text-amber-800 border-amber-200">
                                                 Producto
                                             </span>
                                         </td>
                                         <td class="px-6 py-4 print:px-3 print:py-2 whitespace-nowrap text-sm font-medium text-slate-700">
                                             @det.IdProductoNavigation?.Nombre
                                         </td>
                                         <td class="px-6 py-4 print:px-3 print:py-2 whitespace-nowrap text-center text-sm text-slate-600 font-semibold">
                                             @det.Cantidad.ToString("0.##")
                                         </td>
                                         <td class="px-6 py-4 print:px-3 print:py-2 whitespace-nowrap text-right text-sm text-slate-600">
                                             Bs. @det.PrecioUnitario.ToString("#,##0.##")
                                         </td>
                                         <td class="px-6 py-4 print:px-3 print:py-2 whitespace-nowrap text-right text-sm font-bold text-slate-700">
                                             Bs. @det.Subtotal.ToString("#,##0.##")
                                         </td>
                                     </tr>
                                 }
                             }
                             else
                             {
                                 <tr>
                                     <td colspan="5" class="px-6 py-8 print:py-4 text-center text-slate-400 italic">
                                         No se encontraron detalles para este abastecimiento.
                                     </td>
                                 </tr>
                             }
                         </tbody>
                         <tfoot class="bg-slate-50 print:text-sm">
                             <tr>
                                 <td colspan="4" class="px-6 py-4 print:px-3 print:py-2 text-right font-bold text-slate-600 uppercase tracking-wider">
                                     Suma Total:
                                 </td>
                                 <td class="px-6 py-4 print:px-3 print:py-2 text-right font-bold text-primary text-lg print:text-base">
                                     Bs. @Model.TotalAvastecimiento.ToString("#,##0.##")
                                 </td>
                             </tr>
                         </tfoot>
                     </table>
                 </div>
            </div>
        </div>
    </div>
</div>


