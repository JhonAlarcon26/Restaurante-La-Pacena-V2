@model la_paceña_v2.Models.Venta

@{
    ViewData["Title"] = "Eliminar Venta";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-red-100">
        <!-- Encabezado de Advertencia -->
        <div class="bg-red-500 px-8 py-6 text-white flex items-center">
            <svg class="w-10 h-10 mr-4 text-red-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <div>
                <h2 class="text-2xl font-bold">¿Eliminar Venta Definitivamente?</h2>
                <p class="text-red-100 mt-1">Estás a punto de borrar el registro de esta venta. Esta acción no se puede deshacer.</p>
            </div>
        </div>

        <div class="p-8">
            <h3 class="text-lg font-bold text-slate-800 mb-6 border-b border-slate-200 pb-2">Resumen de la Transacción #@Model.IdVenta</h3>
            
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
                    <dt class="text-sm font-medium text-slate-500">Fecha de Registro</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">@(Model.FechaVenta?.ToString("dd/MM/yyyy HH:mm"))</dd>
                </div>
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
                    <dt class="text-sm font-medium text-slate-500">Cliente</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">@(Model.IdClienteNavigation?.RazonSocial ?? "Venta General")</dd>
                </div>
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
                    <dt class="text-sm font-medium text-slate-500">Registrado Por</dt>
                    <dd class="mt-1 text-base text-slate-700">@(Model.IdUsuarioNavigation?.NombreCompleto ?? "—")</dd>
                </div>
                <div class="bg-red-50 p-4 rounded-lg border border-red-100">
                    <dt class="text-sm font-medium text-red-700">Total de Venta</dt>
                    <dd class="mt-1 text-2xl font-bold text-red-600">Bs. @Model.TotalVenta.ToString("#,##0.##")</dd>
                </div>
            </dl>
            
            <div class="mt-8 bg-yellow-50 border-l-4 border-yellow-400 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-yellow-700 font-medium">
                            Nota: La lógica actual eliminará el registro de la venta. Si corresponde, los stocks y saldos asociados serán restituidos. Asegúrate de que esto sea intencional.
                        </p>
                    </div>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="mt-6 mb-4 p-3 bg-red-50 border-l-4 border-red-500 text-red-700 rounded text-sm">
                    @TempData["Error"]
                </div>
            }

            <div class="mt-8 flex justify-end space-x-4 border-t border-slate-200 pt-6">
                <a asp-action="Listar" class="bg-white border text-center border-slate-300 text-slate-700 font-semibold py-2 px-6 rounded-lg shadow-sm hover:bg-slate-50 transition-colors">
                    Cancelar
                </a>
                
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdVenta" />
                    <button type="submit" class="bg-red-600 text-white font-bold py-2 px-6 rounded-lg shadow-md hover:bg-red-700 hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Sí, Eliminar Definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
