@model Venta

@{
    ViewData["Title"] = "Nueva Venta de Comida";
    var platos = ViewBag.Platos as List<object>; 
}

<div class="max-w-6xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Venta de Comida
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Nueva Venta</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary to-secondary px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Registrar Venta de Comida</h2>
            <p class="text-blue-100 mt-1">Ingresa los datos de la venta</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mx-6 mt-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded">
                <span class="font-semibold">@TempData["Error"]</span>
            </div>
        }

        <div id="customAlert" class="hidden mx-6 mt-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded shadow-md transition-all duration-300">
             <div class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <h3 class="font-bold">Error de Validación</h3>
                    <p id="customAlertMessage">Mensaje de error</p>
                </div>
                <button onclick="document.getElementById('customAlert').classList.add('hidden')" class="ml-auto text-red-500 hover:text-red-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <form asp-action="CrearPlato" method="post" id="formVenta" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="detallesJson" id="detallesJson" />
            <input type="hidden" name="TotalVenta" id="TotalVenta" value="0" />
            
            <div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-6">
                <div>
                    <label asp-for="IdCliente" class="block text-sm font-semibold text-slate-700 mb-2">Cliente</label>
                    <select asp-for="IdCliente" asp-items="ViewBag.IdCliente" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg">
                        <option value="">General</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">NIT/Carnet</label>
                    <input type="text" id="nitCarnetCliente" class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-slate-50 text-slate-600 font-medium" readonly placeholder="Automático" />
                </div>
                <div>
                    <label asp-for="IdSucursal" class="block text-sm font-semibold text-slate-700 mb-2">Sucursal <span class="text-red-500">*</span></label>
                    <select asp-for="IdSucursal" asp-items="ViewBag.IdSucursal" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg">
                        <option value="">Seleccione</option>
                    </select>
                </div>
                <div>
                    <label asp-for="NroMesa" class="block text-sm font-semibold text-slate-700 mb-2">Nro. Mesa</label>
                    <input asp-for="NroMesa" type="number" class="w-full px-4 py-3 border border-slate-300 rounded-lg" placeholder="Opcional" />
                </div>
                <div>
                    <label asp-for="IdTipoPago" class="block text-sm font-semibold text-slate-700 mb-2">Tipo Pago <span class="text-red-500">*</span></label>
                    <select asp-for="IdTipoPago" asp-items="ViewBag.IdTipoPago" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg">
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>

            <div class="border-t border-slate-200 pt-6">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Platos</h3>
                
                <div class="grid grid-cols-12 gap-3 mb-3">
                    <div class="col-span-6">
                        <select id="selectPlato" class="tom-select w-full px-4 py-3 border border-slate-300 rounded-lg">
                            <option value="">Seleccione plato</option>
                            @foreach (dynamic plato in ViewBag.Platos)
                            {
                                <option value="@plato.IdPlato" data-nombre="@plato.Nombre" data-precio="@plato.PrecioVenta">
                                    @plato.Nombre - Bs. @plato.PrecioVenta.ToString("N2")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-span-2">
                        <input type="number" id="inputCantidad" min="1" value="1" placeholder="Cantidad" class="w-full px-4 py-3 border border-slate-300 rounded-lg" />
                    </div>
                    <div class="col-span-2">
                        <input type="number" id="inputPrecio" step="0.01" placeholder="Precio" class="w-full px-4 py-3 border border-slate-300 rounded-lg" />
                    </div>
                    <div class="col-span-2">
                        <button type="button" onclick="agregarDetalle()" class="w-full px-4 py-3 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-lg hover:opacity-90 transition-colors shadow-md flex items-center justify-center">
                            Agregar
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700">Plato</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700">Cantidad</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700">Precio Unit.</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700">Subtotal</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalles" class="bg-white divide-y divide-slate-200">
                            <tr id="filaVacia">
                                <td colspan="5" class="px-4 py-8 text-center text-slate-500">No hay items agregados</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 flex justify-end">
                    <div class="bg-slate-100 px-6 py-3 rounded-lg">
                        <span class="text-lg font-semibold text-slate-700">Total: Bs. <span id="displayTotal" class="text-primary font-bold">0.00</span></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-slate-200">
                <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                    Guardar Venta
                </button>
            </div>
        </form>
    </div>
</div>

<script>
let detalles = [];
let tsPlato = null;
const clientesData = []; 

document.addEventListener('DOMContentLoaded', function() {
    const selectEl = document.getElementById('selectPlato');
    if (selectEl && selectEl.tomselect) {
        tsPlato = selectEl.tomselect;
        tsPlato.on('change', function(value) {
            if (value) {
                const option = selectEl.querySelector('option[value="' + value + '"]');
                if (option) document.getElementById('inputPrecio').value = option.dataset.precio;
            }
        });
    } else {
        selectEl.addEventListener('change', function() {
            const precio = this.options[this.selectedIndex].dataset.precio;
            document.getElementById('inputPrecio').value = precio;
        });
    }
});

function mostrarError(mensaje) {
    const alertBox = document.getElementById('customAlert');
    const alertMsg = document.getElementById('customAlertMessage');
    alertMsg.textContent = mensaje;
    alertBox.classList.remove('hidden');
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => { alertBox.classList.add('hidden'); }, 5000);
}

function agregarDetalle() {
    const selectEl = document.getElementById('selectPlato');
    const inputCantidad = document.getElementById('inputCantidad');
    const inputPrecio = document.getElementById('inputPrecio');
    
    const idPlato = parseInt(selectEl.value);
    const cantidad = parseInt(inputCantidad.value);
    const precio = parseFloat(inputPrecio.value);
    
    let nombrePlato = '';
    // Obtener texto del select
    if (selectEl.options[selectEl.selectedIndex]) nombrePlato = selectEl.options[selectEl.selectedIndex].text.split('- Bs.')[0].trim();

    if (!idPlato) {mostrarError('Debe seleccionar un plato'); return;}
    if (!cantidad || cantidad <= 0) {mostrarError('La cantidad debe ser mayor a 0'); return;}
    if (isNaN(precio) || precio < 0) {mostrarError('Precio inválido'); return;}

    const subtotal = cantidad * precio;
    const index = detalles.findIndex(d => d.IdPlato === idPlato && Math.abs(d.PrecioUnitario - precio) < 0.01);
    
    if (index !== -1) {
        detalles[index].Cantidad += cantidad;
        detalles[index].Subtotal += subtotal;
    } else {
        detalles.push({
            IdPlato: idPlato,
            IdProducto: null,
            Cantidad: cantidad,
            PrecioUnitario: precio,
            Subtotal: subtotal,
            _nombre: nombrePlato
        });
    }

    actualizarTabla();
    inputCantidad.value = 1;
    inputPrecio.value = '';
    if (tsPlato) tsPlato.clear(); else selectEl.value = '';
}

function eliminarDetalle(index) {
    detalles.splice(index, 1);
    actualizarTabla();
}

function actualizarTabla() {
    const tbody = document.getElementById('tablaDetalles');
    const filaVacia = document.getElementById('filaVacia');
    
    Array.from(tbody.querySelectorAll('tr')).forEach(tr => {
        if(tr.id !== 'filaVacia') tr.remove();
    });

    if (detalles.length === 0) {
        filaVacia.style.display = '';
        document.getElementById('displayTotal').textContent = '0.00';
    } else {
        filaVacia.style.display = 'none';
        let total = 0;
        detalles.forEach((det, i) => {
            total += det.Subtotal;
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50 border-b border-slate-100';
            tr.innerHTML = `
                <td class="px-4 py-3 text-sm">${det._nombre}</td>
                <td class="px-4 py-3 text-sm">${det.Cantidad}</td>
                <td class="px-4 py-3 text-sm">Bs. ${det.PrecioUnitario.toFixed(2)}</td>
                <td class="px-4 py-3 text-sm font-semibold">Bs. ${det.Subtotal.toFixed(2)}</td>
                <td class="px-4 py-3 text-sm text-center">
                    <button type="button" onclick="eliminarDetalle(${i})" class="text-red-500 hover:text-red-700">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
        document.getElementById('displayTotal').textContent = total.toFixed(2);
    }
}

document.getElementById('formVenta').addEventListener('submit', function(e) {
    if (detalles.length === 0) {
        e.preventDefault();
        mostrarError('Debe agregar al menos un plato');
        return;
    }
    
    document.querySelectorAll('select.tom-select').forEach(s => {if(s.tomselect) s.value = s.tomselect.getValue();});
    
    if(!document.getElementById('IdSucursal').value) {e.preventDefault(); mostrarError('Seleccione sucursal'); return;}
    if(!document.getElementById('IdTipoPago').value) {e.preventDefault(); mostrarError('Seleccione tipo de pago'); return;}

    const total = detalles.reduce((sum, d) => sum + d.Subtotal, 0);
    document.getElementById('TotalVenta').value = total.toFixed(2).replace(',', '.');
    document.getElementById('detallesJson').value = JSON.stringify(detalles);
});
</script>
