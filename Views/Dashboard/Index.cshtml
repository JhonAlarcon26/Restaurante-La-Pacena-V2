@model la_paceña_v2.Services.DTOs.DashboardKPIsDTO
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="space-y-8 animate-fade-in" x-data="dashboardHandler()">
    <!-- Header Premium -->
    <div class="relative overflow-hidden bg-white rounded-3xl p-8 shadow-sm border border-slate-100 group">
        <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-blue-50 rounded-full opacity-50 blur-3xl transition-all group-hover:scale-110"></div>
        <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">
                    ¡Qué bueno verte, <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">@ViewBag.NombreUsuario</span>!
                </h1>
                <p class="text-slate-500 mt-2 flex items-center gap-2">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                    @ViewBag.NombreRol • @ViewBag.NombreSucursal • <span id="current-time"></span>
                </p>
            </div>
            <div class="flex items-center gap-3">
                <button @@click="refreshData()" class="p-3 bg-slate-50 text-slate-600 rounded-2xl hover:bg-slate-100 transition-all active:scale-95">
                    <i class="fas fa-sync-alt" :class="{ 'animate-spin': loading }"></i>
                </button>
                <a asp-controller="Venta" asp-action="Crear" class="px-6 py-3 bg-slate-900 text-white rounded-2xl font-bold hover:shadow-xl hover:-translate-y-1 transition-all active:scale-95 flex items-center gap-2">
                    <i class="fas fa-plus"></i> Nueva Venta
                </a>
            </div>
        </div>
    </div>

    <!-- Grid de KPIs -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Ventas Hoy -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-all group overflow-hidden relative">
            <div class="absolute bottom-0 right-0 opacity-10 group-hover:scale-110 transition-transform">
                <i class="fas fa-money-bill-wave text-6xl text-blue-600 -mb-4 -mr-4"></i>
            </div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-xl">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <span class="text-slate-500 font-medium">Ventas Hoy</span>
            </div>
            <div class="flex flex-col">
                <span class="text-3xl font-black text-slate-800">Bs. @Model.VentasHoy.ToString("#,##0.##")</span>
                <span class="text-xs font-bold text-green-500 mt-1 flex items-center gap-1">
                    <i class="fas fa-arrow-up"></i> +@Model.TransaccionesHoy transacciones
                </span>
            </div>
        </div>

        <!-- Ventas Mes -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-all group overflow-hidden relative">
            <div class="absolute bottom-0 right-0 opacity-10 group-hover:scale-110 transition-transform">
                <i class="fas fa-chart-line text-6xl text-indigo-600 -mb-4 -mr-4"></i>
            </div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-xl">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <span class="text-slate-500 font-medium">Ventas del Mes</span>
            </div>
            <div class="flex flex-col">
                <span class="text-3xl font-black text-slate-800">Bs. @Model.VentasMes.ToString("#,##0.##")</span>
                <span class="text-xs font-bold text-indigo-500 mt-1">Acumulado mensual</span>
            </div>
        </div>

        <!-- Compras Mes -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-all group overflow-hidden relative">
            <div class="absolute bottom-0 right-0 opacity-10 group-hover:scale-110 transition-transform">
                <i class="fas fa-shopping-cart text-6xl text-amber-600 -mb-4 -mr-4"></i>
            </div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-xl">
                    <i class="fas fa-truck"></i>
                </div>
                <span class="text-slate-500 font-medium">Compras del Mes</span>
            </div>
            <div class="flex flex-col">
                <span class="text-3xl font-black text-slate-800">Bs. @Model.ComprasMes.ToString("#,##0.##")</span>
                <span class="text-xs font-bold text-amber-500 mt-1">Insumos y productos</span>
            </div>
        </div>

        <!-- Alertas Stock -->
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 hover:shadow-md transition-all group overflow-hidden relative">
            <div class="absolute bottom-0 right-0 opacity-10 group-hover:scale-110 transition-transform">
                <i class="fas fa-exclamation-triangle text-6xl text-rose-600 -mb-4 -mr-4"></i>
            </div>
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center text-xl">
                    <i class="fas fa-box-open"></i>
                </div>
                <span class="text-slate-500 font-medium">Alertas Stock</span>
            </div>
            <div class="flex flex-col">
                <span class="text-3xl font-black text-slate-800">@Model.AlertasStockBajo</span>
                <span class="text-xs font-bold text-rose-500 mt-1">Items bajo el mínimo</span>
            </div>
        </div>
    </div>

    <!-- Gráficos y Widgets Centrales -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Gráfico de Ventas Estilo Apple -->
        <div class="lg:col-span-8 bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 relative">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h3 class="text-2xl font-black text-slate-800 tracking-tight">Flujo de Ventas</h3>
                    <p class="text-slate-400 text-sm">Comparativa mensual de rendimiento</p>
                </div>
                <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-wider">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                        <span class="text-slate-600">Actual</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-slate-300"></span>
                        <span class="text-slate-400">Anterior</span>
                    </div>
                </div>
            </div>
            <div class="h-80 w-full">
                <canvas id="salesComparisonChart"></canvas>
            </div>
        </div>

        <!-- Estado de Caja / Meta Diaria -->
        <div class="lg:col-span-4 bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 flex flex-col items-center justify-center text-center relative overflow-hidden group">
            <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-50 rounded-full opacity-20 blur-2xl"></div>
            
            <h3 class="text-xl font-black text-slate-800 mb-6">Estado de Caja</h3>
            
            <div class="relative w-48 h-48 flex items-center justify-center">
                <svg class="w-full h-full transform -rotate-90">
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" class="text-slate-100" />
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" 
                            class="text-blue-600 transition-all duration-1000 ease-out"
                            stroke-dasharray="552.92"
                            :stroke-dashoffset="552.92 - (552.92 * @Model.PorcentajeMeta / 100)" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-4xl font-black text-slate-800">@Model.PorcentajeMeta.ToString("0")%</span>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Meta</span>
                </div>
            </div>

            <div class="mt-8 space-y-2">
                <p class="text-slate-500 font-medium">Bs. @Model.VentasHoy.ToString("#,##0.##") / Bs. @Model.MetaDiaria.ToString("#,##0.##")</p>
                <p class="text-sm font-bold @(Model.PorcentajeMeta >= 100 ? "text-green-600" : "text-blue-600")">
                    @(Model.PorcentajeMeta >= 100 ? "¡Meta Alcanzada! 🎉" : $"Faltan Bs. {(Model.MetaDiaria - Model.VentasHoy > 0 ? Model.MetaDiaria - Model.VentasHoy : 0).ToString("#,##0.##")}")
                </p>
            </div>

            @if (Model.PorcentajeMeta >= 100)
            {
                <template x-if="true">
                    <div x-init="triggerConfetti()"></div>
                </template>
            }
        </div>
    </div>

    <!-- Tercera Fila: Actividad y Tops -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Últimos Movimientos de Kardex -->
        <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
            <h3 class="text-xl font-black text-slate-800 mb-6 flex items-center gap-3">
                <i class="fas fa-history text-blue-600"></i> Actividad Reciente
            </h3>
            <div class="space-y-6">
                @foreach (var mov in Model.UltimosMovimientos)
                {
                    <div class="flex items-center gap-4 group">
                        <div class="w-10 h-10 rounded-2xl flex-shrink-0 flex items-center justify-center text-sm @(mov.TipoMovimiento == "ENTRADA" ? "bg-green-50 text-green-600" : "bg-rose-50 text-rose-600")">
                            <i class="fas @(mov.TipoMovimiento == "ENTRADA" ? "fa-arrow-down" : "fa-arrow-up")"></i>
                        </div>
                        <div class="flex-1 border-b border-slate-50 pb-4 group-last:border-0">
                            <p class="text-sm font-bold text-slate-700 leading-tight">@mov.ItemNombre</p>
                            <div class="flex items-center justify-between mt-1">
                                <span class="text-xs font-medium text-slate-400">@mov.Fecha.ToString("HH:mm") • @mov.Cantidad.ToString("#,##0.##") unidades</span>
                                <span class="text-[10px] font-black uppercase tracking-widest @(mov.TipoMovimiento == "ENTRADA" ? "text-green-500" : "text-rose-500")">@mov.TipoMovimiento</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Producto Estrella de Hoy -->
        <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-6 opacity-10 rotate-12 group-hover:scale-125 transition-transform">
                <i class="fas fa-star text-8xl text-amber-500"></i>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-6">Plato Estrella</h3>
            @if (Model.PlatoEstrella != null)
            {
                <div class="flex flex-col items-center text-center py-4">
                    <div class="w-32 h-32 bg-amber-50 rounded-full flex items-center justify-center text-5xl text-amber-500 mb-6 shadow-inner">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h4 class="text-2xl font-black text-slate-800">@Model.PlatoEstrella.Nombre</h4>
                    <p class="text-slate-500 mt-2 font-medium">@Model.PlatoEstrella.CantidadVendida pedidos hoy</p>
                    <div class="mt-6 px-6 py-2 bg-slate-900 text-white rounded-xl text-sm font-bold">
                        Bs. @Model.PlatoEstrella.IngresosGenerados.ToString("#,##0.##") generados
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center text-center h-full py-12">
                    <i class="fas fa-utensils text-slate-200 text-5xl mb-4"></i>
                    <p class="text-slate-400 font-bold">Sin ventas hoy aún</p>
                </div>
            }
        </div>

        <!-- Accesos Directos -->
        <div class="bg-slate-900 p-8 rounded-[2rem] shadow-2xl relative overflow-hidden flex flex-col justify-between">
            <div class="absolute top-0 left-0 w-full h-full opacity-10">
                <div class="absolute top-10 right-10 w-32 h-32 border-4 border-white rounded-full"></div>
                <div class="absolute bottom-10 left-10 w-20 h-20 border-4 border-white rotate-45"></div>
            </div>
            
            <div>
                <h3 class="text-xl font-black text-white mb-2">Análisis Rápido</h3>
                <p class="text-slate-400 text-sm">Gestiona tu negocio eficientemente</p>
            </div>

            <div class="space-y-3 mt-6 relative z-10">
                <a asp-controller="ReporteVenta" asp-action="Index" class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-2xl text-white transition-all duration-300 group hover:shadow-lg hover:shadow-blue-500/20 hover:-translate-y-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:bg-blue-500/30">
                            <i class="fas fa-chart-line text-blue-400"></i>
                        </div>
                        <span class="font-bold tracking-wide">Reporte de Ventas</span>
                    </div>
                    <div class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 group-hover:bg-white/10 transition-colors">
                        <i class="fas fa-chevron-right text-[10px] opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                    </div>
                </a>

                <a asp-controller="ReporteStock" asp-action="Index" class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-2xl text-white transition-all duration-300 group hover:shadow-lg hover:shadow-rose-500/20 hover:-translate-y-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-rose-500/20 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:bg-rose-500/30">
                            <i class="fas fa-boxes-stacked text-rose-400"></i>
                        </div>
                        <span class="font-bold tracking-wide">Reporte de Stock</span>
                    </div>
                    <div class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 group-hover:bg-white/10 transition-colors">
                        <i class="fas fa-chevron-right text-[10px] opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                    </div>
                </a>

                <a asp-controller="ReporteCompraProducto" asp-action="Index" class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-2xl text-white transition-all duration-300 group hover:shadow-lg hover:shadow-amber-500/20 hover:-translate-y-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-amber-500/20 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:bg-amber-500/30">
                            <i class="fas fa-shopping-basket text-amber-400"></i>
                        </div>
                        <span class="font-bold tracking-wide">Compras de Productos</span>
                    </div>
                    <div class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 group-hover:bg-white/10 transition-colors">
                        <i class="fas fa-chevron-right text-[10px] opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                    </div>
                </a>

                <a asp-controller="ReporteCompraInsumo" asp-action="Index" class="flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-2xl text-white transition-all duration-300 group hover:shadow-lg hover:shadow-emerald-500/20 hover:-translate-y-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:bg-emerald-500/30">
                            <i class="fas fa-leaf text-emerald-400"></i>
                        </div>
                        <span class="font-bold tracking-wide">Compras de Insumos</span>
                    </div>
                    <div class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 group-hover:bg-white/10 transition-colors">
                        <i class="fas fa-chevron-right text-[10px] opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@@1.5.1/dist/confetti.browser.min.js"></script>
    <script>
        function dashboardHandler() {
            return {
                loading: false,
                refreshData() {
                    this.loading = true;
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                }
            }
        }

        function triggerConfetti() {
            const duration = 3 * 1000;
            const end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 2,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: ['#2563eb', '#4f46e5']
                });
                confetti({
                    particleCount: 2,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: ['#2563eb', '#4f46e5']
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            }());
        }

        // Actualizar reloj
        function updateTime() {
            const now = new Date();
            const options = { weekday: 'long', day: 'numeric', month: 'long' };
            document.getElementById('current-time').textContent = now.toLocaleDateString('es-ES', options);
        }
        updateTime();

        // Gráfico de Ventas
        const ctx = document.getElementById('salesComparisonChart').getContext('2d');
        const blueGradient = ctx.createLinearGradient(0, 0, 0, 400);
        blueGradient.addColorStop(0, 'rgba(37, 99, 235, 0.15)');
        blueGradient.addColorStop(1, 'rgba(37, 99, 235, 0)');

        const salesChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.VentasUltimos7Dias.Select(x => x.Fecha.ToString("dd/MM")))),
                datasets: [
                    {
                        label: 'Mes Actual',
                        data: @Html.Raw(Json.Serialize(Model.VentasUltimos7Dias.Select(x => x.Total))),
                        borderColor: '#2563eb',
                        backgroundColor: blueGradient,
                        borderWidth: 4,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 0,
                        pointHoverRadius: 8,
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#2563eb',
                        pointHoverBorderWidth: 4
                    },
                    {
                        label: 'Mes Anterior',
                        data: @Html.Raw(Json.Serialize(Model.VentasUltimos7Dias.Select(x => x.Total * 0.8m))), // Simulación para el ejemplo visual
                        borderColor: '#e2e8f0',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        fill: false,
                        tension: 0.4,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        titleFont: { size: 14, weight: 'bold' },
                        bodyFont: { size: 13 },
                        usePointStyle: true
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9', drawBorder: false },
                        ticks: {
                            color: '#94a3b8',
                            font: { size: 11, weight: '600' },
                            callback: value => 'Bs. ' + value
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: {
                            color: '#94a3b8',
                            font: { size: 11, weight: '600' }
                        }
                    }
                }
            }
        });
    </script>

    <style>
        .animate-fade-in {
            animation: fadeIn 0.8s ease-out forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Custom scrollbar for activity feed */
        .activity-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .activity-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
        }
        .activity-scroll::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }
    </style>
}
