@model la_paceña_v2.Models.Stock

@{
    ViewData["Title"] = "Eliminar Registro de Stock";
    var nombreArticulo = Model.IdInsumo != null ? Model.IdInsumoNavigation?.Nombre : Model.IdProductoNavigation?.Nombre;
}

<div class="max-w-3xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-red-600">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Gestión de Stock
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Eliminar</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-600 px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Confirmar Eliminación</h2>
            <p class="text-red-100 mt-1">Este registro dejará de ser rastreado en el inventario físico</p>
        </div>

        <div class="p-6">
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-500" fill="currentColor" viewBox="0 0 24 24" stroke="none">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-700 font-bold">
                            ¿Está totalmente seguro de eliminar este registro de Stock?
                        </p>
                        <p class="text-xs text-red-600 mt-1">
                            El artículo seguirá existiendo en el sistema, pero ya no aparecerá en reportes de stock ni alertas de inventario.
                        </p>
                    </div>
                </div>
            </div>

            <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 bg-slate-50 p-6 rounded-xl border border-slate-100">
                <div class="sm:col-span-1">
                    <dt class="text-xs font-black text-slate-400 uppercase tracking-widest">Nombre del Artículo</dt>
                    <dd class="mt-1 text-sm text-slate-900 font-bold">@nombreArticulo</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-xs font-black text-slate-400 uppercase tracking-widest">Tipo</dt>
                    <dd class="mt-1 text-sm text-slate-900">
                        <span class="px-2 py-0.5 rounded text-[10px] uppercase font-black @(Model.IdInsumo != null ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                            @(Model.IdInsumo != null ? "Insumo" : "Producto")
                        </span>
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-xs font-black text-slate-400 uppercase tracking-widest">Stock Actual</dt>
                    <dd class="mt-1 text-sm font-bold @(Model.CantidadActual <= Model.CantidadMinima ? "text-red-600" : "text-emerald-600")">
                        @Model.CantidadActual.ToString("N2")
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-xs font-black text-slate-400 uppercase tracking-widest">Stock Mínimo</dt>
                    <dd class="mt-1 text-sm text-slate-900">@Model.CantidadMinima.ToString("N2")</dd>
                </div>
            </dl>
        </div>

        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200">
            <form asp-action="Eliminar" class="flex items-center justify-between">
                <input type="hidden" asp-for="IdStock" />
                <a asp-action="Index" class="px-6 py-3 bg-white border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 transition-all">
                    Cancelar y Volver
                </a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                    <span class="flex items-center font-bold">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        Sí, Eliminar Registro
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>
