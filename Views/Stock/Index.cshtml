@model IEnumerable<la_paceña_v2.Models.Stock>

@{
    ViewData["Title"] = "Gestión de Stock";
}

<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-slate-800 mb-2">Administración de Stock</h1>
            <p class="text-slate-600">Control centralizado de existencias físico y niveles críticos</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a asp-action="Crear" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Registrar Stock
            </a>
        </div>
    </div>
</div>

<div class="mb-6">
    <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400 group-focus-within:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
        <input type="text" id="busquedaStock" 
               class="block w-full pl-11 pr-4 py-3 border border-slate-200 rounded-xl leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary sm:text-sm transition-all duration-200 shadow-sm hover:border-slate-300" 
               placeholder="Buscar en el stock por nombre de artículo o tipo...">
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-lg">
        <p class="text-red-700 font-medium">@TempData["Error"]</p>
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 rounded-lg">
        <p class="text-green-700 font-medium">@TempData["Mensaje"]</p>
    </div>
}

<div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase">Artículo</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase">Tipo</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase">Stock Actual</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase">Stock Mínimo</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-700 uppercase">Última Actualización</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold text-slate-700 uppercase">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200" id="tablaStockCuerpo">
                @foreach (var item in Model)
                {
                    bool esBajo = item.CantidadActual <= item.CantidadMinima;
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-slate-900">
                                @(item.IdInsumo != null ? item.IdInsumoNavigation?.Nombre : item.IdProductoNavigation?.Nombre)
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-wide @(item.IdInsumo != null ? "bg-blue-100 text-blue-700 border border-blue-200" : "bg-indigo-100 text-indigo-700 border border-indigo-200")">
                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    @if(item.IdInsumo != null) { <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"></path> }
                                    else { <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path> }
                                </svg>
                                @(item.IdInsumo != null ? "INSUMO" : "PRODUCTO")
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @{
                                var unidad = item.IdInsumo != null ? item.IdInsumoNavigation?.IdUnidadNavigation?.Abreviatura : item.IdProductoNavigation?.IdUnidadNavigation?.Abreviatura;
                            }
                            @if (esBajo)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 border border-red-200 animate-pulse">
                                    @FormatDecimal(item.CantidadActual) @unidad
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                    @FormatDecimal(item.CantidadActual) @unidad
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-500">
                            @FormatDecimal(item.CantidadMinima) <span class="text-[10px] text-slate-400">@unidad</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            @item.UltimaActualizacion?.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex items-center justify-end space-x-2">
                                <a asp-action="Editar" asp-route-id="@item.IdStock" 
                                   class="inline-flex items-center px-3 py-1.5 bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition-colors">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                    Editar
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@item.IdStock" 
                                   class="inline-flex items-center px-3 py-1.5 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-slate-900">No hay registros de stock</h3>
            <p class="mt-1 text-sm text-slate-500">Comienza creando un nuevo registro de stock.</p>
        </div>
    }
</div>

@functions {
    string FormatDecimal(decimal? value)
    {
        if (value == null) return "0";
        decimal val = value.Value;
        if (val == Math.Floor(val))
            return val.ToString("F0");
        return val.ToString("0.##");
    }
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            inicializarBuscador('busquedaStock', 'tablaStockCuerpo');
        });
    </script>
}
