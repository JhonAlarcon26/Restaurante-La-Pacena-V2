@model la_paceña_v2.Models.Stock

@{
    ViewData["Title"] = "Editar Configuración de Stock";
    var unidadActual = Model.IdInsumo != null 
        ? Model.IdInsumoNavigation?.IdUnidadNavigation?.Abreviatura 
        : Model.IdProductoNavigation?.IdUnidadNavigation?.Abreviatura;
}

<div class="max-w-3xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-amber-600">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Gestión de Stock
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Editar</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary to-secondary px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Configurar Inventario</h2>
            <p class="text-blue-100 mt-1">Modifica la vinculación o niveles de alerta del artículo</p>
        </div>

        <form asp-action="Editar" class="p-6">
            <input type="hidden" asp-for="IdStock" />
            
            <div asp-validation-summary="ModelOnly" class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>
            
            <div class="space-y-6">
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                        Vincular Artículo (Elija solo uno)
                    </h3>

                    <div class="grid grid-cols-1 gap-6">
                        <div>
                            <label for="IdInsumo" class="block text-sm font-semibold text-slate-700 mb-2">Insumo</label>
                            <select id="IdInsumo" name="IdInsumo" class="tom-select w-full">
                                <option value="">Seleccione una opción...</option>
                                @if (ViewBag.InsumosLista != null)
                                {
                                    foreach (dynamic item in ViewBag.InsumosLista)
                                    {
                                        if ((int)item.Id == Model.IdInsumo)
                                        {
                                            <option value="@item.Id" selected="selected" data-unidad="@item.Unidad">@item.Nombre</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Id" data-unidad="@item.Unidad">@item.Nombre</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="flex items-center justify-center my-2">
                            <div class="flex-grow border-t border-slate-300"></div>
                            <span class="mx-4 text-xs font-bold text-slate-400 uppercase tracking-widest bg-slate-50 px-2">Ó</span>
                            <div class="flex-grow border-t border-slate-300"></div>
                        </div>

                        <div>
                            <label for="IdProducto" class="block text-sm font-semibold text-slate-700 mb-2">Producto</label>
                            <select id="IdProducto" name="IdProducto" class="tom-select w-full">
                                <option value="">Seleccione una opción...</option>
                                @if (ViewBag.ProductosLista != null)
                                {
                                    foreach (dynamic item in ViewBag.ProductosLista)
                                    {
                                        if ((int)item.Id == Model.IdProducto)
                                        {
                                            <option value="@item.Id" selected="selected" data-unidad="@item.Unidad">@item.Nombre</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Id" data-unidad="@item.Unidad">@item.Nombre</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div id="section-unidad" class="@(unidadActual != null ? "bg-indigo-50 border border-primary" : "bg-slate-50 border border-dashed border-slate-300 opacity-50") rounded-xl p-4 flex flex-col justify-center items-center transition-all duration-300">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Unidad de Medida</span>
                        <div id="unidad-display" class="text-xl font-black @(unidadActual != null ? "text-primary" : "text-slate-400")">
                            @(unidadActual ?? "---")
                        </div>
                    </div>

                    <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="CantidadActual" class="block text-sm font-semibold text-slate-700 mb-2">Existencia Actual</label>
                            <input asp-for="CantidadActual" type="number" step="0.01" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-slate-700" />
                            <span asp-validation-for="CantidadActual" class="text-red-500 text-sm"></span>
                        </div>
                        <div>
                            <label asp-for="CantidadMinima" class="block text-sm font-semibold text-slate-700 mb-2">Stock Mínimo</label>
                            <input asp-for="CantidadMinima" type="number" step="0.01" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-bold text-slate-700" />
                            <span asp-validation-for="CantidadMinima" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-slate-200">
                <a asp-action="Index" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all font-medium">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Guardar Cambios
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var selectInsumo = document.getElementById('IdInsumo');
            var selectProducto = document.getElementById('IdProducto');
            var displayUnidad = document.getElementById('unidad-display');
            var sectionUnidad = document.getElementById('section-unidad');

            var unidadMap = {};
            @if (ViewBag.InsumosLista != null)
            {
                foreach (dynamic item in ViewBag.InsumosLista)
                {
                    @:unidadMap['insumo_@item.Id'] = '@item.Unidad';
                }
            }
            @if (ViewBag.ProductosLista != null)
            {
                foreach (dynamic item in ViewBag.ProductosLista)
                {
                    @:unidadMap['producto_@item.Id'] = '@item.Unidad';
                }
            }

            function activarUnidad(unidad) {
                sectionUnidad.className = 'bg-indigo-50 border border-primary rounded-xl p-4 flex flex-col justify-center items-center transition-all duration-300 scale-105';
                displayUnidad.textContent = unidad;
                displayUnidad.className = 'text-xl font-black text-primary';
                setTimeout(function() { sectionUnidad.classList.remove('scale-105'); }, 200);
            }

            function resetearUnidad() {
                sectionUnidad.className = 'bg-slate-50 border border-dashed border-slate-300 rounded-xl p-4 flex flex-col justify-center items-center opacity-50 transition-all duration-300';
                displayUnidad.textContent = '---';
                displayUnidad.className = 'text-xl font-black text-slate-400';
            }

            function onInsumoChange(value) {
                if (value) {
                    if (selectProducto.tomselect) selectProducto.tomselect.clear(true);
                    var unidad = unidadMap['insumo_' + value] || '---';
                    activarUnidad(unidad);
                } else if (!selectProducto.value) {
                    resetearUnidad();
                }
            }

            function onProductoChange(value) {
                if (value) {
                    if (selectInsumo.tomselect) selectInsumo.tomselect.clear(true);
                    var unidad = unidadMap['producto_' + value] || '---';
                    activarUnidad(unidad);
                } else if (!selectInsumo.value) {
                    resetearUnidad();
                }
            }

            function formatNumberInput(input) {
                if (input.value) {
                    var val = parseFloat(input.value);
                    if (val === Math.floor(val)) {
                        input.value = val.toFixed(0);
                    } else {
                        input.value = val.toString();
                    }
                }
                input.addEventListener('blur', function() {
                    if (this.value) {
                        var val = parseFloat(this.value);
                        if (val === Math.floor(val)) {
                            this.value = val.toFixed(0);
                        } else {
                            this.value = val.toString();
                        }
                    }
                });
            }

            document.querySelectorAll('input[type="number"]').forEach(formatNumberInput);

            setTimeout(function() {
                if (selectInsumo && selectInsumo.tomselect) {
                    selectInsumo.tomselect.on('change', onInsumoChange);
                }
                if (selectProducto && selectProducto.tomselect) {
                    selectProducto.tomselect.on('change', onProductoChange);
                }
            }, 150);
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
