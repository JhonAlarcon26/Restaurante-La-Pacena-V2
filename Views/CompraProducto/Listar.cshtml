@model IEnumerable<la_paceña_v2.Models.Abastecimiento>

@{
    ViewData["Title"] = "Compras de Productos";
}

<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-slate-800 mb-2">Compra de Productos</h1>
            <p class="text-slate-600">Registro de entrada de productos terminados para la venta</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a asp-action="Crear" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Nuevo Registro de Compra
            </a>
        </div>
    </div>
</div>

<div class="mb-6">
    <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400 group-focus-within:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
        <input type="text" id="busquedaAbastecimiento" 
               class="block w-full pl-11 pr-4 py-3 border border-slate-200 rounded-xl leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary sm:text-sm transition-all duration-200 shadow-sm hover:border-slate-300" 
               placeholder="Buscar compra por ID, fecha, proveedor o usuario...">
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 rounded-lg shadow-sm animate-pulse">
        <p class="text-green-700 font-medium flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            @TempData["Mensaje"]
        </p>
    </div>
}

<div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50 text-slate-700">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Fecha</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Proveedor</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Registrado Por</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Artículos</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Total</th>
                    <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200" id="tablaAbastecimientoCuerpo">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#@item.IdAbastecimiento</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">@(item.FechaAbastecimiento?.ToString("dd/MM/yyyy HH:mm"))</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">@(item.IdProveedorNavigation?.NombreEmpresa ?? "S/P")</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">@item.IdUsuarioNavigation?.Nombre</td>
                        <td class="px-6 py-4 text-sm text-slate-600">
                            <div class="flex flex-wrap gap-1">
                                @if(item.DetalleAbastecimientos != null)
                                {
                                    foreach (var det in item.DetalleAbastecimientos.Take(3))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800">
                                            @det.Cantidad x @(det.IdProductoNavigation?.Nombre ?? "Producto")
                                        </span>
                                    }
                                    if (item.DetalleAbastecimientos.Count > 3)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600 italic">
                                            + @(item.DetalleAbastecimientos.Count - 3) más...
                                        </span>
                                    }
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-green-600">Bs. @item.TotalAbastecimiento.ToString("#,##0.##")</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex items-center justify-end space-x-2">
                                <a asp-action="Ver" asp-route-id="@item.IdAbastecimiento" class="p-2 text-primary hover:bg-blue-50 rounded-lg transition-colors" title="Ver Detalle">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@item.IdAbastecimiento" method="post" class="inline">
                                    <button type="submit" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Eliminar">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-slate-500">
                             No se han registrado compras.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            inicializarBuscador('busquedaAbastecimiento', 'tablaAbastecimientoCuerpo');
        });
    </script>
}
