@model la_paceña_v2.Models.CompraProducto

@{
    ViewData["Title"] = "Nueva Compra";
}

<div class="max-w-6xl mx-auto">
    <nav class="flex mb-6">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a asp-action="Listar" class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-primary">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    Compras de Productos
                </a>
            </li>
            <li><svg class="w-6 h-6 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg></li>
            <li><span class="text-sm font-medium text-slate-500">Nueva Compra de Productos</span></li>
        </ol>
    </nav>

    <div class="bg-white rounded-xl shadow-lg border border-slate-200">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-2xl font-bold text-white">Registrar Compra</h2>
            <p class="text-blue-100 mt-1">Ingresa productos terminados para aumentar el stock de venta</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mx-6 mt-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded shadow-sm">
                <div class="flex items-center mb-2">
                    <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <h3 class="font-bold">Error en la validación</h3>
                </div>
                <div asp-validation-summary="All" class="text-sm font-medium pl-7"></div>
            </div>
        }

        <div id="customAlert" class="hidden mx-6 mt-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded shadow-md z-50">
             <div class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <h3 class="font-bold">Error</h3>
                    <p id="customAlertMessage"></p>
                </div>
                <button onclick="document.getElementById('customAlert').classList.add('hidden')" class="ml-auto text-red-500 hover:text-red-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <form asp-action="Crear" method="post" id="formCompra" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="detallesJson" id="detallesJson" />
            <input type="hidden" name="Total" id="inputTotal" value="0" />
            
            <div class="space-y-8">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
                        <div class="md:col-span-4">
                            <label asp-for="IdProveedor" class="block text-sm font-semibold text-slate-700 mb-2">Proveedor</label>
                            <select asp-for="IdProveedor" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-slate-50">
                                <option value="">Seleccione un proveedor</option>
                            </select>
                        </div>
                        
                        <div class="md:col-span-4">
                             <label class="block text-sm font-semibold text-slate-700 mb-2">NIT / Carnet</label>
                             <input type="text" id="inputNit" readonly class="w-full px-4 py-3 bg-slate-100 border border-slate-300 rounded-lg text-slate-600" placeholder="---" />
                        </div>

                         <div class="md:col-span-4">
                            <label asp-for="NroReferencia" class="block text-sm font-semibold text-slate-700 mb-2">Nro. Referencia</label>
                            <input asp-for="NroReferencia" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Ej: REF-001" />
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-700 mb-4">Seleccionar Productos</h3>
                    <div class="grid grid-cols-12 gap-4 items-end">
                        <div class="col-span-12 md:col-span-3">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Producto</label>
                            <select id="selectProducto" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            </select>
                        </div>
                        <div class="col-span-6 md:col-span-1">
                             <label class="block text-sm font-semibold text-slate-700 mb-2">Unidad</label>
                             <div class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-500 font-bold text-center" id="unidadDisplay">-</div>
                        </div>
                         <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Cantidad</label>
                            <input type="number" id="inputCantidad" step="0.01" min="0.01" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary" placeholder="0.00" />
                        </div>
                        <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Precio Compra</label>
                            <input type="number" id="inputPrecio" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary" placeholder="0.00" />
                        </div>
                        <div class="col-span-6 md:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Precio Venta</label>
                            <input type="number" id="inputPrecioVenta" step="0.01" min="0" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary" placeholder="0.00" />
                        </div>
                        <div class="col-span-6 md:col-span-2">
                            <button type="button" onclick="agregarProducto()" class="w-full py-3 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md">
                                AGREGAR
                            </button>
                        </div>
                    </div>
                </div>

                <div class="border-t border-slate-200 pt-6">
                    <h3 class="text-lg font-semibold text-slate-800 mb-4">Detalle de la Compra</h3>
                    <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
                        <table class="min-w-full divide-y divide-slate-200">
                            <thead class="bg-slate-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Producto</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Cantidad</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Precio Compra</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Precio Venta</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Subtotal</th>
                                    <th class="px-6 py-3 text-right text-xs font-bold text-slate-500 uppercase">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tablaDetalles" class="bg-white divide-y divide-slate-200">
                                <tr id="filaVacia">
                                    <td colspan="6" class="px-6 py-10 text-center text-slate-400">
                                        No hay productos agregados.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="bg-slate-50 font-bold">
                                <tr>
                                    <td colspan="4" class="px-6 py-4 text-right">TOTAL:</td>
                                    <td class="px-6 py-4 text-primary text-lg">Bs. <span id="displayTotal">0.00</span></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="flex justify-end space-x-3 mt-8">
                        <a asp-action="Listar" class="px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-all">Cancelar</a>
                        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-bold rounded-lg shadow-lg hover:opacity-95 transform hover:-translate-y-0.5 transition-all">
                            Guardar Compra
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let detalles = @Html.Raw(string.IsNullOrEmpty((string)ViewBag.DetallesRestaurados) ? "[]" : ViewBag.DetallesRestaurados);
        let tsProducto;
        const proveedoresData = @Html.Raw(ViewBag.ProveedoresJson ?? "[]");
        const productosData = @Html.Raw(ViewBag.ProductosJson ?? "[]");

        document.addEventListener("DOMContentLoaded", function () {
            new TomSelect('#IdProveedor', {
                options: proveedoresData,
                valueField: 'IdProveedor',
                labelField: 'Empresa',
                searchField: ['Empresa', 'NitCarnet'],
                onChange: function(val) {
                    const p = proveedoresData.find(x => x.IdProveedor == val);
                    document.getElementById('inputNit').value = p ? p.NitCarnet : '';
                }
            });

            tsProducto = new TomSelect('#selectProducto', {
                options: productosData,
                valueField: 'IdProducto',
                labelField: 'Nombre',
                searchField: ['Nombre'],
                onChange: function(val) {
                    const p = productosData.find(x => x.IdProducto == val);
                    if(p) {
                         document.getElementById('unidadDisplay').textContent = p.Unidad || '-';
                         document.getElementById('inputPrecio').value = (p.PrecioCompra !== null && p.PrecioCompra !== undefined) ? p.PrecioCompra : '';
                         document.getElementById('inputPrecioVenta').value = (p.PrecioVenta !== null && p.PrecioVenta !== undefined) ? p.PrecioVenta : '';
                    } else {
                         document.getElementById('unidadDisplay').textContent = '-';
                         document.getElementById('inputPrecio').value = '';
                         document.getElementById('inputPrecioVenta').value = '';
                    }
                }
            });

            if (detalles.length > 0) {
                actualizarTabla();
            }
        });

        function agregarProducto() {
            const id = parseInt(tsProducto.getValue());
            const cant = parseFloat(document.getElementById('inputCantidad').value);
            const precio = parseFloat(document.getElementById('inputPrecio').value);
            const precioVenta = parseFloat(document.getElementById('inputPrecioVenta').value);

            if(!id) { mostrarError("Seleccione un producto"); return; }
            if(!cant || cant <= 0) { mostrarError("Ingrese una cantidad válida"); return; }
            if(isNaN(precio) || precio < 0) { mostrarError("Precio de CompraInsumo no válido"); return; }
            if(isNaN(precioVenta) || precioVenta < 0) { mostrarError("Precio de venta no válido"); return; }

            const prod = productosData.find(x => x.IdProducto == id);

            const indexExistente = detalles.findIndex(d => d.IdProducto === id);

            if (indexExistente !== -1) {
                detalles[indexExistente].Cantidad += cant;
                detalles[indexExistente].PrecioUnitario = precio;
                detalles[indexExistente].PrecioVentaNuevo = precioVenta;
                detalles[indexExistente].Subtotal = detalles[indexExistente].Cantidad * precio;
            } else {
                detalles.push({
                    IdProducto: id,
                    Nombre: prod.Nombre,
                    Cantidad: cant,
                    PrecioUnitario: precio,
                    PrecioVentaNuevo: precioVenta,
                    Subtotal: cant * precio
                });
            }

            tsProducto.clear();
            document.getElementById('inputCantidad').value = '';
            document.getElementById('inputPrecio').value = '';
            document.getElementById('inputPrecioVenta').value = '';
            document.getElementById('unidadDisplay').textContent = '-';
            
            actualizarTabla();
        }

        function quitar(index) {
            detalles.splice(index, 1);
            actualizarTabla();
        }

        function actualizarTabla() {
            const tbody = document.getElementById('tablaDetalles');
            const filaVacia = document.getElementById('filaVacia');
            
            const rows = tbody.querySelectorAll('tr:not(#filaVacia)');
            rows.forEach(r => r.remove());

            if(detalles.length === 0) {
                filaVacia.style.display = '';
                document.getElementById('displayTotal').textContent = '0.00';
                return;
            }
            filaVacia.style.display = 'none';

            let total = 0;
            detalles.forEach((d, i) => {
                total += d.Subtotal;
                const tr = document.createElement('tr');
                const pc = d.PrecioUnitario || 0;
                const pv = d.PrecioVentaNuevo !== undefined ? d.PrecioVentaNuevo.toFixed(2) : '-';
                tr.innerHTML = `
                    <td class="px-6 py-4 text-sm font-medium text-slate-800">${d.Nombre}</td>
                    <td class="px-6 py-4 text-sm text-slate-600">${d.Cantidad}</td>
                    <td class="px-6 py-4 text-sm text-slate-600">Bs. ${pc.toFixed(2)}</td>
                    <td class="px-6 py-4 text-sm text-slate-600">Bs. ${pv}</td>
                    <td class="px-6 py-4 text-sm font-bold text-slate-700">Bs. ${d.Subtotal.toFixed(2)}</td>
                    <td class="px-6 py-4 text-right">
                        <button type="button" onclick="quitar(${i})" class="text-red-600 text-sm font-bold bg-red-50 border border-red-300 px-4 py-1.5 rounded-lg hover:bg-red-100 hover:border-red-400 transition-all shadow-sm active:scale-95">Quitar</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            document.getElementById('displayTotal').textContent = total.toFixed(2);
        }

        function mostrarError(msg) {
            const div = document.getElementById('customAlert');
            document.getElementById('customAlertMessage').textContent = msg;
            div.classList.remove('hidden');
            setTimeout(() => div.classList.add('hidden'), 3000);
        }

        document.getElementById('formCompra').addEventListener('submit', function(e) {
            const idProveedor = document.getElementById('IdProveedor').value;
            if(!idProveedor) {
                e.preventDefault();
                mostrarError("Debe seleccionar un proveedor");
                return;
            }

            if(detalles.length === 0) {
                e.preventDefault();
                mostrarError("Agregue al menos un producto");
                return;
            }
            document.getElementById('detallesJson').value = JSON.stringify(detalles);
            document.getElementById('inputTotal').value = detalles.reduce((a, b) => a + b.Subtotal, 0);
        });
    </script>
}


